{
  "name": "emirceylan-website",
  "type": "module",
  "version": "2.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "check:links": "node scripts/link-check.mjs dist",
    "check:privacy": "node scripts/privacy-check.mjs dist",
    "check": "npm run typecheck && npm run build && npm run check:links && npm run check:privacy",
    "audit": "node scripts/audit.mjs",
    "icons": "node scripts/make-icons.mjs",
    "cv:pdf": "node scripts/build-cv-pdf.mjs",
    "format": "prettier --write \"src/**/*.{astro,ts,css,mjs}\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css,mjs}\" \"scripts/*.mjs\"",
    "cms:local": "decap-server"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@supabase/supabase-js": "^2.99.3",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^5.17.1",
    "decap-cms-app": "^3.15.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "chrome-launcher": "^1.2.1",
    "decap-server": "^3.10.0",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "satori": "^0.33.4",
    "typescript": "^5.9.3"
  },
  "private": true,
  "description": "Personal site of Emir Ceylan \u2014 Astro 5, Tailwind 4, Supabase visitor gallery."
}
