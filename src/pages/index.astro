---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Full work history lives on the unlisted recruiter page (link-based privacy,
// not authentication). It is intentionally NOT linked from any public page.
// Teaser numbers below are derived from that page's role/project list.
const projectCount = 7;

const skillCategories = [
  { title: 'PROGRAMMING',    items: ['Python', 'C++'] },
  { title: 'LIBRARIES',      items: ['NumPy', 'pandas', 'matplotlib', 'scikit-learn', 'Biopython'] },
  { title: 'TOOLS',          items: ['Git/GitHub', 'Jupyter Notebook', 'Ubuntu', 'Claude Code', 'Clawbot'] },
  { title: 'LANGUAGES',      items: ['English (Fluent, C1)', 'Turkish (Native)'] },
  { title: 'CREATIVE SKILLS',items: ['Adobe Photoshop', 'Adobe Premiere Pro', 'Digital Illustration', 'Painting', 'Drawing'] },
  { title: 'INTERESTS',      items: ['Bioinformatics', 'AI in Medicine', 'Chess', 'Archery', 'Jiu-Jitsu', 'Fitness', 'Tattoo Design'] },
];
---

<Layout title="EMIR CEYLAN — Creative Developer">
  <Header />

  <main>
    <!-- ═══ HERO — Crimson neural scramble ════════════════════════════════════ -->
    <section class="hero-section" data-screen-label="01 hero">
      <div class="hero-inner">

        <div class="status" id="hero-status-wrap">
          <span class="pulse" aria-hidden="true"></span>
          <span id="hero-status">SYS_ID: EC_2027 — ISTANBUL / TR — ONLINE</span>
        </div>

        <div class="hero-name-frame" id="name-wrap">
          <h1 class="hero-name" aria-label="EMIR CEYLAN">
            <span class="ln ln-1" id="ln1" data-text="EMİR"></span>
            <span class="ln ln-2" id="ln2" data-text="CEYLAN"></span>
          </h1>
        </div>

        <div class="hero-subtitle" id="hero-subtitle">
          <span class="bullet"></span>
          <span>CS STUDENT — AI FOR HEALTHCARE</span>
          <span class="bullet"></span>
        </div>

        <div class="hero-ctas" id="hero-ctas">
          <a href="#work" class="btn btn-primary">MY WORK <span aria-hidden="true">→</span></a>
          <a href="#contact" class="btn btn-secondary">CONTACT</a>
        </div>

        <div class="scroll-cue" id="scroll-cue">SCROLL</div>
      </div>
    </section>

    <!-- ═══ MARQUEE BAR ═══════════════════════════════════════════════════════ -->
    <section class="py-3 overflow-hidden" style="background:var(--bg-surface); border-top:1px solid var(--border-color); border-bottom:1px solid var(--border-color);">
      <div class="marquee-container">
        <div class="marquee-content font-mono">
          <span class="font-bold text-xs mx-10" style="color:var(--text-secondary); letter-spacing:0.1em;">  ◆ Medical AI Specialist</span>
          <span class="font-bold text-xs mx-10" style="color:var(--text-secondary); letter-spacing:0.1em;">  ◆ Data Scientist</span>
          <span class="font-bold text-xs mx-10" style="color:var(--text-secondary); letter-spacing:0.1em;">  ◆ Machine Learning Researcher</span>
          <span class="font-bold text-xs mx-10" style="color:var(--text-secondary); letter-spacing:0.1em;">  ◆ Sabancı University TA</span>
          <span class="font-bold text-xs mx-10" style="color:var(--text-secondary); letter-spacing:0.1em;">  ◆ Team Leader</span>
          <span class="font-bold text-xs mx-10" style="color:var(--text-secondary); letter-spacing:0.1em;">  ◆ XAI Enthusiast</span>
          <span class="font-bold text-xs mx-10" style="color:var(--accent); letter-spacing:0.1em;">  ◆ Artist</span>
          <span class="font-bold text-xs mx-10" style="color:var(--text-secondary); letter-spacing:0.1em;">  ◆ Medical AI Specialist</span>
          <span class="font-bold text-xs mx-10" style="color:var(--text-secondary); letter-spacing:0.1em;">  ◆ Data Scientist</span>
          <span class="font-bold text-xs mx-10" style="color:var(--text-secondary); letter-spacing:0.1em;">  ◆ Machine Learning Researcher</span>
          <span class="font-bold text-xs mx-10" style="color:var(--text-secondary); letter-spacing:0.1em;">  ◆ Sabancı University TA</span>
          <span class="font-bold text-xs mx-10" style="color:var(--text-secondary); letter-spacing:0.1em;">  ◆ Team Leader</span>
          <span class="font-bold text-xs mx-10" style="color:var(--text-secondary); letter-spacing:0.1em;">  ◆ XAI Enthusiast</span>
          <span class="font-bold text-xs mx-10" style="color:var(--accent); letter-spacing:0.1em;">  ◆ Artist</span>
        </div>
      </div>
    </section>

    <!-- ═══ ABOUT ══════════════════════════════════════════════════════════════ -->
    <section id="about" class="about-section py-20 px-6 md:px-12">
      <div class="max-w-7xl mx-auto">

        <div class="grid md:grid-cols-3 gap-8 items-start">

          <!-- Left: Section label panel -->
          <div class="panel about-label-panel">
            <p class="font-mono text-xs mb-4" style="color:var(--text-secondary); letter-spacing:0.15em;">01 / ABOUT</p>
            <div class="font-black leading-none" style="font-family:'Syne'; font-size:clamp(56px,8vw,96px); color:var(--text-primary); line-height:0.88;">
              ABOUT
            </div>
            <div class="mt-8" style="border-top:1px solid var(--border-color); padding-top:20px;">
              <p class="font-mono text-xs mb-1" style="color:var(--text-secondary); letter-spacing:0.12em;">SYSTEM PROFILE</p>
              <p class="font-mono text-xs mt-2" style="color:var(--text-secondary); opacity:0.6; letter-spacing:0.08em;">CLASS / 2027</p>
              <p class="font-mono text-xs mt-1" style="color:var(--text-secondary); opacity:0.6; letter-spacing:0.08em;">NODE / ISTANBUL, TR</p>
            </div>

            <!-- Stats inside left panel -->
            <div class="mt-8 flex flex-col gap-4" style="border-top:1px solid var(--border-color); padding-top:20px;">
              <div>
                <div class="stat-num font-black text-2xl" style="color:var(--accent);"
                     data-counter="2027">2027</div>
                <div class="font-mono text-xs mt-1" style="color:var(--text-secondary); letter-spacing:0.1em;">EXPECTED GRAD</div>
              </div>
              <div>
                <div class="stat-num font-black text-2xl" style="color:var(--accent);"
                     data-counter="7" data-pad="2" data-suffix="+">07+</div>
                <div class="font-mono text-xs mt-1" style="color:var(--text-secondary); letter-spacing:0.1em;">PROJECTS</div>
              </div>
              <div>
                <div class="stat-num font-black text-2xl" style="color:var(--accent);">AI</div>
                <div class="font-mono text-xs mt-1" style="color:var(--text-secondary); letter-spacing:0.1em;">SPECIALIZATION</div>
              </div>
            </div>
          </div>

          <!-- Right: Narrative panel -->
          <div class="md:col-span-2 panel">
            <p class="font-mono text-xs mb-6" style="color:var(--text-secondary); letter-spacing:0.12em;">PROFILE_NARRATIVE.txt</p>
            <p class="text-xl md:text-2xl font-bold mb-6" style="color:var(--text-primary); line-height:1.6;">
              Computer Science student at
              <span style="color:var(--accent);">Sabancı University</span>
              passionate about AI applications in healthcare. Building the future of medical AI.
            </p>
            <p class="text-base mb-4" style="color:var(--text-secondary); line-height:1.7;">
              Driven by the potential of AI to bridge gaps in modern medicine, I focus on developing intelligent systems that are as ethical as they are efficient. My work at Sabancı University centers on collaborating with professors and fellow students to build projects that connect deep CS knowledge with complex medical hurdles to find practical, scalable solutions.
            </p>
            <p class="text-base" style="color:var(--text-secondary); line-height:1.7;">
              Outside of the lab, I balance the logic of neural networks with painting — a creative outlet that allows me to view technical challenges through a more expressive, lateral-thinking lens.
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══ WORK — recruiter teaser (full history is on an unlisted page) ═════ -->
    <section id="work" class="py-16 px-6 md:px-12" style="border-top:1px solid var(--border-color); border-bottom:1px solid var(--border-color); padding-left:2rem; padding-right:2rem;">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-end gap-4 mb-10">
          <p class="font-mono text-xs" style="color:var(--text-secondary); letter-spacing:0.15em; align-self:center;">02 /</p>
          <h2 class="text-5xl md:text-7xl font-black kinetic-text work-heading" style="color:var(--text-primary);">WORK</h2>
          <div class="section-line flex-1 h-px" style="background:var(--border-color);"></div>
          <span class="text-xl font-black font-mono" style="color:var(--text-secondary);"
                data-counter={projectCount} data-prefix="/" data-pad="2">/{projectCount.toString().padStart(2, '0')}</span>
        </div>

        <div class="work-teaser panel">
          <div class="grid md:grid-cols-3 gap-8 items-center">

            <!-- Count -->
            <div class="work-teaser-count">
              <div class="font-black leading-none" style="color:var(--accent); font-family:'Space Grotesk'; font-size:clamp(72px,11vw,128px); line-height:0.85;"
                   data-counter={projectCount} data-pad="2" data-suffix="+">00+</div>
              <p class="font-mono text-xs mt-3" style="color:var(--text-secondary); letter-spacing:0.14em;">ROLES &amp; RESEARCH PROJECTS</p>
            </div>

            <!-- Specialization + CTA -->
            <div class="md:col-span-2">
              <p class="font-mono text-xs mb-4" style="color:var(--text-secondary); letter-spacing:0.14em;">SPECIALIZATION</p>
              <p class="text-xl md:text-2xl font-bold mb-6" style="color:var(--text-primary); line-height:1.5;">
                Machine learning &amp; data science for
                <span style="color:var(--accent);">healthcare</span> — explainable diagnostic
                models, clinical ML, and bioinformatics pipelines.
              </p>

              <p class="text-sm font-mono mb-8" style="color:var(--text-secondary); line-height:1.8; letter-spacing:0.02em;">
                &gt; Teaching assistantship, undergraduate research, a Teknofest medical-AI
                team lead, a clinical ML internship, and independent bioinformatics work.
              </p>

              <div class="work-teaser-cta">
                <p class="font-mono text-sm mb-4" style="color:var(--text-primary);">
                  Full work history available to recruiters on request.
                </p>
                <div class="flex flex-wrap gap-4 items-center">
                  <a href="mailto:emir.ceylan@sabanciuniv.edu?subject=Work%20history%20request"
                     class="teaser-btn primary font-mono text-xs font-bold cut-corner-sm">
                    REQUEST FULL HISTORY →
                  </a>
                  <a href="#contact" class="teaser-btn font-mono text-xs font-bold cut-corner-sm">
                    CONTACT
                  </a>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- ═══ SKILLS ════════════════════════════════════════════════════════════ -->
    <section id="skills" class="py-16 px-6 md:px-12" style="padding-left:2rem; padding-right:2rem;">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-end gap-4 mb-10">
          <p class="font-mono text-xs" style="color:var(--text-secondary); letter-spacing:0.15em; align-self:center;">03 /</p>
          <h2 class="text-5xl md:text-7xl font-black kinetic-text skills-heading" style="color:var(--text-primary);">SKILLS</h2>
          <div class="section-line flex-1 h-px" style="background:var(--border-color);"></div>
          <span class="text-xl font-black font-mono" style="color:var(--text-secondary);"
                data-counter="6" data-prefix="/" data-pad="2">/06</span>
        </div>

        <div class="skills-grid">
          {skillCategories.map((category) => (
            <div class="skill-group">
              <div class="skill-group-head">
                <span class="skill-group-title font-black font-mono">{category.title}</span>
                <span class="skill-group-count font-mono">{category.items.length.toString().padStart(2, '0')}</span>
              </div>
              <div class="skill-chips">
                {category.items.map((item) => (
                  <span class="skill-chip font-mono">{item}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ── Marquee ─────────────────────────────────────────────────────────────── */
  .marquee-container { overflow: hidden; white-space: nowrap; }
  .marquee-content { display: inline-block; animation: marquee 20s linear infinite; }
  @keyframes marquee {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* ─── HERO — Crimson neural variant ────────────────────────────────────── */
  .hero-section {
    position: relative;
    z-index: 10;
    min-height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 32px 40px;
  }
  .hero-inner {
    width: 100%;
    max-width: 1200px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
  }

  /* Status bar */
  .status {
    display: inline-flex; align-items: center; gap: 12px;
    padding: 9px 16px 9px 14px;
    border: 1px solid rgba(170, 170, 170, 0.18);
    background: rgba(10, 10, 10, 0.55);
    backdrop-filter: blur(8px);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--text-secondary);
    letter-spacing: 0.14em;
    margin-bottom: 36px;
    opacity: 0;
    transition: opacity .35s ease;
  }
  .status.in { opacity: 1; }
  .status .pulse {
    position: relative;
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 rgba(196, 30, 58, 0.7);
    animation: heartbeat 1.5s ease-in-out infinite;
  }
  .status .caret {
    display: inline-block; width: 7px; height: 12px;
    background: var(--accent); margin-left: -2px;
    animation: tw-blink 0.85s steps(2) infinite;
  }

  /* Name */
  .hero-name {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: clamp(5rem, 17vw, 13.5rem);
    line-height: 0.88;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    margin: 0;
  }
  .hero-name .ln { display: block; position: relative; }
  .hero-name .ln-1 { color: var(--text-primary); }
  .hero-name .ln-2 {
    color: var(--accent);
    text-shadow: 0 0 24px rgba(196, 30, 58, 0.35), 0 0 60px rgba(196, 30, 58, 0.15);
  }
  .hero-name .ch { display: inline-block; position: relative; }
  .hero-name .ch.sp { width: 0.28em; }

  /* Chromatic aberration on CEYLAN */
  .ln-2.aberrate {
    animation: aberrate 600ms cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }
  .ln-2 .ch::before, .ln-2 .ch::after {
    content: attr(data-ch);
    position: absolute; left: 0; top: 0;
    opacity: 0;
    pointer-events: none;
  }
  .ln-2 .ch::before { color: var(--accent-bri); transform: translateX(0); }
  .ln-2 .ch::after  { color: #0FB3D1;            transform: translateX(0); mix-blend-mode: screen; }
  .ln-2.aberrate .ch::before { animation: aber-r 600ms cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards; }
  .ln-2.aberrate .ch::after  { animation: aber-b 600ms cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards; }
  @keyframes aberrate {
    0%   { filter: blur(0.5px); }
    40%  { filter: blur(0.3px); }
    100% { filter: blur(0); }
  }
  @keyframes aber-r {
    0%   { opacity: 0; transform: translateX(0); }
    30%  { opacity: 0.85; transform: translateX(-4px); }
    70%  { opacity: 0.7;  transform: translateX(-4px); }
    100% { opacity: 0;    transform: translateX(0); }
  }
  @keyframes aber-b {
    0%   { opacity: 0; transform: translateX(0); }
    30%  { opacity: 0.85; transform: translateX(4px); }
    70%  { opacity: 0.7;  transform: translateX(4px); }
    100% { opacity: 0;    transform: translateX(0); }
  }

  /* Subtitle */
  .hero-subtitle {
    margin-top: 36px;
    display: inline-flex; align-items: center; gap: 10px;
    padding: 11px 20px;
    border: 1px solid rgba(170, 170, 170, 0.16);
    background: rgba(10, 10, 10, 0.45);
    backdrop-filter: blur(6px);
    font-family: 'JetBrains Mono', monospace;
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.18em;
    color: var(--text-primary);
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity .5s ease, transform .5s ease;
  }
  .hero-subtitle.in { opacity: 1; transform: translateY(0); }
  .hero-subtitle .bullet {
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  /* CTAs */
  .hero-ctas {
    margin-top: 28px;
    display: inline-flex; gap: 18px;
    align-items: center;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity .5s ease, transform .5s ease;
  }
  .hero-ctas.in { opacity: 1; transform: translateY(0); }

  .btn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 14px 26px;
    cursor: pointer;
    transition: all 300ms ease;
    display: inline-flex; align-items: center; gap: 10px;
    border: 1px solid transparent;
  }
  .btn-primary {
    color: var(--accent);
    border-color: var(--accent);
    background: transparent;
  }
  .btn-primary:hover {
    background: var(--accent);
    color: #fff;
    box-shadow: 0 0 24px rgba(196, 30, 58, 0.45);
  }
  .btn-secondary {
    color: var(--text-primary);
    padding: 14px 4px;
    border: none;
    background: transparent;
    position: relative;
  }
  .btn-secondary::after {
    content: '';
    position: absolute;
    left: 4px; right: 4px; bottom: 10px;
    height: 1px; background: var(--text-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .3s ease;
  }
  .btn-secondary:hover::after { transform: scaleX(1); }

  /* Scroll cue */
  .scroll-cue {
    position: absolute;
    bottom: 32px; left: 50%;
    transform: translateX(-50%);
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--text-secondary);
    opacity: 0;
    transition: opacity .5s ease;
    pointer-events: none;
  }
  .scroll-cue.in { opacity: 0.6; }
  .scroll-cue::after {
    content: '';
    display: block;
    width: 1px; height: 24px;
    background: linear-gradient(180deg, var(--text-secondary), transparent);
    margin: 8px auto 0;
    animation: drift 2.2s ease-in-out infinite;
  }
  @keyframes drift {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50%      { transform: translateY(6px); opacity: 0.15; }
  }

  @media (prefers-reduced-motion: reduce) {
    .status, .hero-subtitle, .hero-ctas, .scroll-cue {
      opacity: 1 !important; transform: none !important;
    }
  }

  /* ── About section ───────────────────────────────────────────────────────── */
  .about-section { background: var(--bg-base); }
  .about-label-panel { min-height: 100%; }

  /* ── Work teaser (replaces the detailed work cards) ─────────────────────── */
  .work-teaser { padding: clamp(1.75rem, 4vw, 3rem); }
  .work-teaser-count {
    border-left: 2px solid var(--accent);
    padding-left: 24px;
  }
  .work-teaser-cta {
    padding-top: 20px;
    border-top: 1px dashed var(--border-color);
  }
  .teaser-btn {
    display: inline-flex; align-items: center;
    padding: 13px 22px;
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    letter-spacing: 0.1em;
    text-decoration: none;
    transition: border-color .2s, color .2s, background .2s, box-shadow .2s;
  }
  .teaser-btn:hover {
    border-color: var(--accent);
    color: #fff;
    background: var(--accent);
    box-shadow: 0 0 14px var(--accent-glow);
  }
  .teaser-btn.primary {
    border-color: var(--accent);
    color: var(--accent);
  }
  .teaser-btn.primary:hover { color: #fff; }

  @media (max-width: 767px) {
    .work-teaser-count { border-left: none; border-top: 2px solid var(--accent); padding-left: 0; padding-top: 16px; }
  }

  /* ── Skills — spacious grouped chips ────────────────────────────────────── */
  .skills-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  @media (min-width: 768px) {
    .skills-grid { grid-template-columns: repeat(2, 1fr); gap: 2.5rem 3rem; }
  }

  .skill-group {
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--border-color);
  }
  .skill-group-head {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 12px;
    margin-bottom: 1.1rem;
  }
  .skill-group-title {
    font-size: 13px;
    letter-spacing: 0.16em;
    color: var(--text-primary);
    text-transform: uppercase;
  }
  .skill-group-count {
    font-size: 12px;
    color: var(--accent);
    letter-spacing: 0.08em;
  }
  .skill-chips {
    display: flex; flex-wrap: wrap; gap: 10px;
  }
  .skill-chip {
    display: inline-flex; align-items: center;
    padding: 8px 14px;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    transition: border-color .2s ease, color .2s ease, background .2s ease;
  }
  .skill-chip:hover {
    border-color: var(--accent);
    color: #fff;
    background: rgba(196,30,58,0.12);
  }
</style>

<script>
  // ── Binary float teleport ───────────────────────────────────────────────────
  document.querySelectorAll('.binary-float').forEach(el => {
    el.addEventListener('animationiteration', () => {
      el.style.top    = (Math.random() * 80 + 5) + '%';
      el.style.left   = (Math.random() * 85 + 5) + '%';
      el.style.right  = 'auto';
      el.style.bottom = 'auto';
    });
  });

  // ── GSAP Entrance + Scroll Animations ──────────────────────────────────────
  /* Crimson hero name scramble + chromatic aberration */
  (function nameReveal() {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const SCRAMBLE = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#@&%*+={}<>/';

    function splitInto(node) {
      const text = node.dataset.text || '';
      node.innerHTML = '';
      const spans = [];
      for (const ch of text) {
        const s = document.createElement('span');
        s.className = 'ch' + (ch === ' ' ? ' sp' : '');
        s.setAttribute('data-ch', ch);
        s.textContent = ch === ' ' ? ' ' : ch;
        node.appendChild(s);
        spans.push({ el: s, final: ch });
      }
      return spans;
    }

    function scramble(spans, baseDelay) {
      const DUR = 1200, STG = 60, TICK = 45;
      spans.forEach((s, idx) => {
        if (s.final === ' ') return;
        const start = baseDelay + idx * STG;
        setTimeout(() => {
          if (reduced) { s.el.textContent = s.final; return; }
          const resolveAtAbs = performance.now() + DUR;
          const interval = setInterval(() => {
            if (performance.now() >= resolveAtAbs) {
              clearInterval(interval);
              s.el.textContent = s.final;
              return;
            }
            s.el.textContent = SCRAMBLE[Math.floor(Math.random() * SCRAMBLE.length)];
          }, TICK);
        }, start);
      });
      return baseDelay + (spans.length - 1) * STG + DUR;
    }

    const ln1 = document.getElementById('ln1');
    const ln2 = document.getElementById('ln2');
    if (!ln1 || !ln2) return;
    const ln1Spans = splitInto(ln1);
    const ln2Spans = splitInto(ln2);

    if (reduced) {
      ln1Spans.forEach(s => s.el.textContent = s.final);
      ln2Spans.forEach(s => s.el.textContent = s.final);
      document.getElementById('name-wrap')?.classList.add('framed');
    } else {
      scramble(ln1Spans, 0);
      const e2 = scramble(ln2Spans, 100);
      const aberrAt = e2 + 40;
      setTimeout(() => {
        ln2.classList.add('aberrate');
        setTimeout(() => ln2.classList.remove('aberrate'), 700);
        document.getElementById('name-wrap')?.classList.add('framed');
      }, aberrAt);
    }

    ln2.addEventListener('mouseenter', () => {
      if (reduced || ln2.classList.contains('aberrate')) return;
      ln2.classList.add('aberrate');
      setTimeout(() => ln2.classList.remove('aberrate'), 650);
    });
  })();

  /* Status typewriter */
  (function statusTypewriter() {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const el = document.getElementById('hero-status');
    const TARGET = 'SYS_ID: EC_2027 — ISTANBUL / TR — ONLINE';
    if (!el) return;
    if (reduced) { el.textContent = TARGET; return; }

    const TOTAL = 600;
    el.textContent = '';
    let i = 0;
    function tick() {
      i++;
      el.textContent = TARGET.slice(0, i);
      if (i < TARGET.length) {
        const dt = TOTAL / TARGET.length + (Math.random() - 0.5) * 18;
        setTimeout(tick, dt);
      } else {
        const caret = document.createElement('span');
        caret.className = 'caret';
        el.parentElement?.appendChild(caret);
      }
    }
    setTimeout(tick, 400);
  })();

  /* Cinematic load sequence */
  (function loadSequence() {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const $ = (id) => document.getElementById(id);
    const els = {
      status: $('hero-status-wrap'),
      sub:    $('hero-subtitle'),
      ctas:   $('hero-ctas'),
      cue:    $('scroll-cue'),
    };
    if (reduced) {
      Object.values(els).forEach(e => e?.classList.add('in'));
      return;
    }
    setTimeout(() => els.status?.classList.add('in'),  400);
    setTimeout(() => els.sub?.classList.add('in'),    1400);
    setTimeout(() => els.ctas?.classList.add('in'),   1600);
    setTimeout(() => els.cue?.classList.add('in'),    1900);
  })();

  /* GSAP scroll-trigger animations */
  (function() {
    if (typeof gsap === 'undefined') return;

    // ── Character split utility ───────────────────────────────────────────

    // ── Section line grow ─────────────────────────────────────────────────
    gsap.utils.toArray('.section-line').forEach(line => {
      gsap.fromTo(line,
        { scaleX: 0, transformOrigin: 'left center' },
        {
          scaleX: 1,
          duration: 1,
          ease: 'power3.inOut',
          scrollTrigger: { trigger: line, start: 'top 85%' }
        }
      );
    });

    // ── About section reveal ──────────────────────────────────────────────
    gsap.from('#about .panel', {
      opacity: 0, y: 45, stagger: 0.15, duration: 0.7, ease: 'power3.out',
      scrollTrigger: { trigger: '#about', start: 'top 72%' }
    });

    // ── Work section ──────────────────────────────────────────────────────
    gsap.from('.work-heading', {
      opacity: 0, x: -50, duration: 0.7, ease: 'power3.out',
      scrollTrigger: { trigger: '#work', start: 'top 78%' }
    });

    gsap.from('.work-teaser', {
      opacity: 0, y: 45, duration: 0.7, ease: 'power3.out',
      scrollTrigger: { trigger: '.work-teaser', start: 'top 85%' }
    });

    // ── Skills section ────────────────────────────────────────────────────
    gsap.from('.skills-heading', {
      opacity: 0, x: -50, duration: 0.7, ease: 'power3.out',
      scrollTrigger: { trigger: '#skills', start: 'top 78%' }
    });

    gsap.from('.skill-group', {
      opacity: 0, y: 30, stagger: 0.1, duration: 0.55, ease: 'power3.out',
      scrollTrigger: { trigger: '.skills-grid', start: 'top 82%' }
    });
  })();
</script>
