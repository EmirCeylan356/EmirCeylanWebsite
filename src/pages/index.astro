---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site';
import { CONTENT, PUBLIC_CAPABILITIES, PUBLIC_DOMAINS, PUBLIC_SKILLS, roleCount, contactMailto } from '../data/profile';

// PRIVACY: this page is public. Everything below is anonymised capability
// language — no employer, dataset, project, course, or professor names. The
// full history lives on the unlisted recruiter page (link-based privacy, not
// authentication) and is shared on request. See src/data/profile.ts.

// Editable copy comes from src/data/content.json (see content.schema.md).
const { hero, marquee, about, work } = CONTENT;
const marqueeAccent = marquee[marquee.length - 1];

// About lede: "{university}" is rendered in the accent colour, "{gradYear}" is
// replaced with SITE.gradYear.
const [ledeBefore, ledeAfter = ''] = about.lede.replace('{gradYear}', String(SITE.gradYear)).split('{university}');

// The roles stat is computed from code (roleCount) and slotted in as the 2nd stat.
const roleStat = { value: `${String(roleCount).padStart(2, '0')}+`, label: 'ROLES & RESEARCH PROJECTS', counter: roleCount, pad: '2', suffix: '+' };
const stats = [about.stats[0], roleStat, ...about.stats.slice(1)];
---

<Layout
  title={`Emir Ceylan — ${SITE.tagline.replace('MEDICAL AI', 'Medical AI').replace('ML', 'ML')}`}
  titleRaw
  description={SITE.description}
  type="profile"
>
  <Header />

  <main id="main">
    <!-- ═══ HERO — Crimson neural scramble ════════════════════════════════════ -->
    <section class="hero-section" data-screen-label="01 hero" aria-labelledby="hero-heading">
      <div class="hero-inner">

        <div class="status" id="hero-status-wrap" aria-hidden="true">
          <span class="pulse"></span>
          <span id="hero-status">{hero.status}</span>
        </div>

        <div class="hero-name-frame" id="name-wrap">
          <h1 class="hero-name" id="hero-heading">
            <span class="sr-only">Emir Ceylan</span>
            <span class="ln ln-1" id="ln1" aria-hidden="true">{[...'EMİR'].map((ch) => <span class="ch" data-ch={ch}>{ch}</span>)}</span>
            <span class="ln ln-2" id="ln2" aria-hidden="true">{[...'CEYLAN'].map((ch) => <span class="ch" data-ch={ch}>{ch}</span>)}</span>
          </h1>
        </div>

        <p class="hero-subtitle" id="hero-subtitle">
          <span class="bullet" aria-hidden="true"></span>
          <span>{hero.subtitle}</span>
          <span class="bullet" aria-hidden="true"></span>
        </p>

        <div class="hero-ctas" id="hero-ctas">
          <a href="#work" class="btn btn-primary">{hero.ctaPrimary} <span aria-hidden="true">→</span></a>
          <a href="#contact" class="btn btn-secondary">{hero.ctaSecondary}</a>
        </div>

        <div class="scroll-cue" id="scroll-cue" aria-hidden="true">SCROLL</div>
      </div>
    </section>

    <!-- ═══ MARQUEE BAR ═══════════════════════════════════════════════════════ -->
    <section class="marquee-bar" aria-label="Areas of work">
      <div class="marquee-container">
        <ul class="marquee-content font-mono" aria-hidden="true">
          {[...marquee, ...marquee].map((item) => (
            <li class={item === marqueeAccent ? 'is-accent' : ''}><span aria-hidden="true">◆</span> {item}</li>
          ))}
        </ul>
        <p class="sr-only">{marquee.join(' · ')}</p>
      </div>
    </section>

    <!-- ═══ ABOUT ══════════════════════════════════════════════════════════════ -->
    <section id="about" class="about-section section" aria-labelledby="about-heading">
      <div class="container">
        <div class="grid md:grid-cols-3 gap-6 md:gap-8 items-start" data-reveal-stagger>

          <!-- Left: Section label panel -->
          <div class="panel about-label-panel">
            <p class="eyebrow">01 / ABOUT</p>
            <h2 id="about-heading" class="display-word">ABOUT</h2>
            <div class="mt-8 pt-5 divider-top">
              <p class="eyebrow mb-1">SYSTEM PROFILE</p>
              <p class="meta-line mt-2">CLASS / {SITE.gradYear}</p>
              <p class="meta-line mt-1">NODE / ISTANBUL, TR</p>
            </div>

            <dl class="mt-8 pt-5 divider-top flex flex-col gap-4 stats">
              {stats.map((s) => (
                <div>
                  <dd class="stat-num" data-counter={s.counter} data-pad={'pad' in s ? s.pad : undefined} data-suffix={'suffix' in s ? s.suffix : undefined}>{s.value}</dd>
                  <dt class="stat-label">{s.label}</dt>
                </div>
              ))}
            </dl>
          </div>

          <!-- Right: Narrative panel -->
          <div class="md:col-span-2 panel narrative">
            <p class="eyebrow mb-6">PROFILE_NARRATIVE.txt</p>
            <p class="lede">
              {ledeBefore}<span class="accent-text">{SITE.university}</span>{ledeAfter}
            </p>
            {about.paragraphs.map((text) => <p>{text}</p>)}
          </div>

        </div>
      </div>
    </section>

    <!-- ═══ WORK — recruiter teaser (full history is on an unlisted page) ═════ -->
    <section id="work" class="section work-section" aria-labelledby="work-heading">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">02 /</p>
          <h2 id="work-heading" class="section-title kinetic-text" data-reveal="left">WORK</h2>
          <div class="section-line" data-reveal="line"></div>
          <span class="section-count font-mono" data-counter={roleCount} data-prefix="/" data-pad="2">/{String(roleCount).padStart(2, '0')}</span>
        </div>

        <!-- What I actually do -->
        <div class="work-intro" data-reveal>
          <p class="eyebrow mb-4">{work.eyebrow}</p>
          <p class="lede">{work.lede}</p>
          <p class="work-intro-body">{work.body}</p>
          <ul class="domain-tags" aria-label="Domains">
            {PUBLIC_DOMAINS.map((d) => <li>{d}</li>)}
          </ul>
        </div>

        <!-- Capability tiles: anonymised, real numbers -->
        <ul class="tile-grid" data-reveal-stagger aria-label="Selected results">
          {PUBLIC_CAPABILITIES.map((c) => (
            <li class="tile">
              <p class="tile-label font-mono">{c.label}</p>
              <p class="tile-metric"><span class="tile-num">{c.metric}</span><span class="tile-unit">{c.unit}</span></p>
              <p class="tile-desc">{c.description}</p>
              <p class="tile-stack font-mono">{c.stack}</p>
            </li>
          ))}
        </ul>

        <!-- CTA -->
        <div class="work-cta panel" data-reveal>
          <div>
            <p class="eyebrow mb-3">{work.ctaEyebrow}</p>
            <p class="work-cta-text">{work.ctaText}</p>
          </div>
          <div class="work-cta-actions">
            <a href={contactMailto(work.ctaSubject)} class="btn-cta primary font-mono">
              {work.ctaPrimary} <span aria-hidden="true">→</span>
            </a>
            <a href="#contact" class="btn-cta font-mono">{work.ctaSecondary}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ SKILLS ════════════════════════════════════════════════════════════ -->
    <section id="skills" class="section skills-section" aria-labelledby="skills-heading">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">03 /</p>
          <h2 id="skills-heading" class="section-title kinetic-text" data-reveal="left">SKILLS</h2>
          <div class="section-line" data-reveal="line"></div>
          <span class="section-count font-mono" data-counter={PUBLIC_SKILLS.primary.length + PUBLIC_SKILLS.secondary.length} data-prefix="/" data-pad="2">/{String(PUBLIC_SKILLS.primary.length + PUBLIC_SKILLS.secondary.length).padStart(2, '0')}</span>
        </div>

        <div class="skills-grid" data-reveal-stagger>
          {PUBLIC_SKILLS.primary.map((category) => (
            <div class="skill-group">
              <div class="skill-group-head">
                <h3 class="skill-group-title font-mono">{category.title}</h3>
                <span class="skill-group-count font-mono" aria-hidden="true">{category.items.length.toString().padStart(2, '0')}</span>
              </div>
              {category.note && <p class="skill-group-note">{category.note}</p>}
              <ul class="skill-chips">
                {category.items.map((item) => (
                  <li class="skill-chip font-mono">{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <!-- Deliberately smaller second block -->
        <div class="skills-secondary" data-reveal>
          <p class="eyebrow mb-5">ALSO</p>
          <div class="skills-grid compact">
            {PUBLIC_SKILLS.secondary.map((category) => (
              <div class="skill-group">
                <div class="skill-group-head">
                  <h3 class="skill-group-title font-mono">{category.title}</h3>
                </div>
                <ul class="skill-chips">
                  {category.items.map((item) => (
                    <li class="skill-chip small font-mono">{item}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ── Layout primitives (page-local; tokens come from global.css) ─────────── */
  .container { max-width: 80rem; margin-inline: auto; padding-inline: var(--gutter); }
  .section { padding-block: var(--section-y); }
  .section-head {
    display: flex; align-items: flex-end; gap: var(--space-4);
    margin-bottom: clamp(var(--space-8), 5vw, var(--space-16));
  }
  .section-head .eyebrow { align-self: center; margin: 0; }
  .section-title {
    font-size: clamp(2.75rem, 7vw, 4.5rem);
    font-weight: 900;
    color: var(--text-primary);
  }
  .section-line { flex: 1; height: 1px; background: var(--border-color); align-self: center; }
  .section-count { font-size: 1.25rem; font-weight: 900; color: var(--text-secondary); }

  .eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }
  .meta-line { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; letter-spacing: 0.08em; color: var(--text-tertiary); }
  .divider-top { border-top: 1px solid var(--border-color); }
  .display-word {
    font-size: clamp(3.5rem, 8vw, 6rem);
    font-weight: 900; line-height: 0.88; letter-spacing: -0.02em;
    color: var(--text-primary);
  }
  .lede {
    font-size: clamp(1.15rem, 1.1rem + 0.6vw, 1.5rem);
    font-weight: 700; line-height: 1.5;
    color: var(--text-primary);
    margin-bottom: var(--space-6);
    text-wrap: balance;
  }
  .narrative p:not(.lede):not(.eyebrow) {
    color: var(--text-secondary); line-height: 1.75; font-size: 1rem;
    margin-bottom: var(--space-4);
    max-width: 62ch;
  }
  .narrative p:last-child { margin-bottom: 0; }

  .stats dd { margin: 0; }
  .stat-num { font-size: 1.5rem; font-weight: 900; color: var(--accent); line-height: 1.1; }
  .stat-label { font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; letter-spacing: 0.1em; color: var(--text-secondary); margin-top: 0.25rem; }

  /* ── Marquee ─────────────────────────────────────────────────────────────── */
  .marquee-bar {
    padding-block: var(--space-3);
    overflow: hidden;
    background: var(--bg-surface);
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }
  .marquee-container { overflow: hidden; white-space: nowrap; }
  .marquee-content {
    display: inline-flex; list-style: none; margin: 0; padding: 0;
    animation: marquee 36s linear infinite;
  }
  .marquee-content li {
    font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em;
    color: var(--text-secondary);
    padding-inline: var(--space-8);
  }
  .marquee-content li span { color: var(--border-color); margin-right: 0.35em; }
  .marquee-content li.is-accent { color: var(--accent-text); }
  .marquee-content li.is-accent span { color: var(--accent-text); }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content { animation: none; flex-wrap: wrap; white-space: normal; justify-content: center; row-gap: 0.25rem; }
    .marquee-content li:nth-child(n + 8) { display: none; }
  }

  /* ─── HERO — Crimson neural variant ────────────────────────────────────── */
  .hero-section {
    position: relative;
    z-index: 10;
    min-height: 100vh;
    min-height: 100dvh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 96px var(--gutter) 72px;
  }
  .hero-inner {
    width: 100%;
    max-width: 1200px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
  }

  /* Status bar */
  .status {
    display: inline-flex; align-items: center; gap: 12px;
    padding: 9px 16px 9px 14px;
    border: 1px solid rgba(170, 170, 170, 0.18);
    background: rgba(10, 10, 10, 0.55);
    backdrop-filter: blur(8px);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--text-secondary);
    letter-spacing: 0.14em;
    margin-bottom: 36px;
    opacity: 0;
    transition: opacity .35s ease;
  }
  .status.in { opacity: 1; }
  .status .pulse {
    position: relative;
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 rgba(196, 30, 58, 0.7);
    animation: heartbeat 1.5s ease-in-out infinite;
  }
  .status .caret {
    display: inline-block; width: 7px; height: 12px;
    background: var(--accent); margin-left: -2px;
    animation: tw-blink 0.85s steps(2) infinite;
  }

  /* Name */
  .hero-name {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: clamp(4.25rem, 16.5vw, 13.5rem);
    line-height: 0.88;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    margin: 0;
  }
  .hero-name .ln { display: block; position: relative; }
  .hero-name .ln-1 { color: var(--text-primary); }
  .hero-name .ln-2 {
    color: var(--accent);
    text-shadow: 0 0 24px rgba(196, 30, 58, 0.35), 0 0 60px rgba(196, 30, 58, 0.15);
  }
  .hero-name .ch { display: inline-block; position: relative; vertical-align: top; line-height: inherit; text-align: left; }
  .hero-name .ch.sp { width: 0.28em; }

  /* Chromatic aberration on CEYLAN */
  .ln-2.aberrate {
    animation: aberrate 600ms cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }
  .ln-2 .ch::before, .ln-2 .ch::after {
    content: attr(data-ch);
    position: absolute; left: 0; top: 0;
    opacity: 0;
    pointer-events: none;
  }
  .ln-2 .ch::before { color: var(--accent-bri); transform: translateX(0); }
  .ln-2 .ch::after  { color: #0FB3D1;            transform: translateX(0); mix-blend-mode: screen; }
  .ln-2.aberrate .ch::before { animation: aber-r 600ms cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards; }
  .ln-2.aberrate .ch::after  { animation: aber-b 600ms cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards; }
  @keyframes aberrate {
    0%   { filter: blur(0.5px); }
    40%  { filter: blur(0.3px); }
    100% { filter: blur(0); }
  }
  @keyframes aber-r {
    0%   { opacity: 0; transform: translateX(0); }
    30%  { opacity: 0.85; transform: translateX(-4px); }
    70%  { opacity: 0.7;  transform: translateX(-4px); }
    100% { opacity: 0;    transform: translateX(0); }
  }
  @keyframes aber-b {
    0%   { opacity: 0; transform: translateX(0); }
    30%  { opacity: 0.85; transform: translateX(4px); }
    70%  { opacity: 0.7;  transform: translateX(4px); }
    100% { opacity: 0;    transform: translateX(0); }
  }

  /* Subtitle */
  .hero-subtitle {
    margin-top: 36px;
    display: inline-flex; align-items: center; gap: 10px;
    padding: 11px 20px;
    border: 1px solid rgba(170, 170, 170, 0.16);
    background: rgba(10, 10, 10, 0.45);
    backdrop-filter: blur(6px);
    font-family: 'JetBrains Mono', monospace;
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.18em;
    color: var(--text-primary);
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity .5s ease, transform .5s ease;
  }
  .hero-subtitle.in { opacity: 1; transform: translateY(0); }
  .hero-subtitle .bullet {
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  /* CTAs */
  .hero-ctas {
    margin-top: 28px;
    display: inline-flex; gap: 18px;
    align-items: center;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity .5s ease, transform .5s ease;
  }
  .hero-ctas.in { opacity: 1; transform: translateY(0); }

  .btn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 14px 26px;
    min-height: 44px;
    cursor: pointer;
    transition: background var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
    display: inline-flex; align-items: center; gap: 10px;
    border: 1px solid transparent;
  }
  .btn-primary {
    color: var(--accent-text);
    border-color: var(--accent);
    background: transparent;
  }
  .btn-primary:hover {
    background: var(--accent);
    color: #fff;
    box-shadow: 0 0 24px rgba(196, 30, 58, 0.45);
  }
  .btn-secondary {
    color: var(--text-primary);
    padding: 14px 4px;
    border: none;
    background: transparent;
    position: relative;
  }
  .btn-secondary::after {
    content: '';
    position: absolute;
    left: 4px; right: 4px; bottom: 10px;
    height: 1px; background: var(--text-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .btn-secondary:hover::after { transform: scaleX(1); }

  /* Scroll cue */
  .scroll-cue {
    position: absolute;
    bottom: -48px; left: 50%;
    transform: translateX(-50%);
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--text-secondary);
    opacity: 0;
    transition: opacity .5s ease;
    pointer-events: none;
  }
  .scroll-cue.in { opacity: 0.6; }
  .scroll-cue::after {
    content: '';
    display: block;
    width: 1px; height: 24px;
    background: linear-gradient(180deg, var(--text-secondary), transparent);
    margin: 8px auto 0;
    animation: drift 2.2s ease-in-out infinite;
  }
  @keyframes drift {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50%      { transform: translateY(6px); opacity: 0.15; }
  }

  @media (prefers-reduced-motion: reduce) {
    .status, .hero-subtitle, .hero-ctas, .scroll-cue {
      opacity: 1 !important; transform: none !important;
    }
    .scroll-cue { display: none; }
  }
  @media (max-width: 480px) {
    .hero-subtitle { letter-spacing: 0.12em; font-size: 11px; padding: 10px 14px; }
    .hero-ctas { flex-direction: column; gap: 6px; }
  }

  /* ── About section ───────────────────────────────────────────────────────── */
  .about-section { background: var(--bg-base); }
  .about-label-panel { min-height: 100%; }

  /* ── Work section ────────────────────────────────────────────────────────── */
  .work-section { border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color); }
  .work-intro { max-width: 68ch; margin-bottom: clamp(var(--space-8), 5vw, var(--space-12)); }
  .work-intro-body { color: var(--text-secondary); line-height: 1.75; margin-bottom: var(--space-6); }
  .domain-tags { display: flex; flex-wrap: wrap; gap: var(--space-2); list-style: none; padding: 0; margin: 0; }
  .domain-tags li {
    font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--accent-text); border: 1px solid var(--accent-dim);
    padding: 6px 10px;
  }

  .tile-grid {
    display: grid; gap: 1px;
    background: var(--border-color);
    border: 1px solid var(--border-color);
    list-style: none; padding: 0; margin: 0;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px)  { .tile-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .tile-grid { grid-template-columns: repeat(4, 1fr); } }
  .tile {
    background: var(--bg-surface);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    display: flex; flex-direction: column; gap: var(--space-3);
    position: relative;
    transition: background var(--dur-base) var(--ease-out);
  }
  .tile::before {
    content: ''; position: absolute; inset: 0 auto 0 0; width: 2px;
    background: var(--accent); transform: scaleY(0); transform-origin: top;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .tile:hover { background: var(--bg-elevated); }
  .tile:hover::before { transform: scaleY(1); }
  .tile-label { font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--text-secondary); }
  .tile-metric { display: flex; align-items: baseline; gap: 0.35rem; line-height: 1; margin: 0; }
  .tile-num { font-size: clamp(2rem, 3.2vw, 2.75rem); font-weight: 900; color: var(--accent); letter-spacing: -0.02em; }
  .tile-unit { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: var(--text-secondary); letter-spacing: 0.06em; }
  .tile-desc { font-size: 0.9rem; line-height: 1.55; color: var(--text-primary); flex: 1; }
  .tile-stack { font-size: 0.65rem; letter-spacing: 0.06em; color: var(--text-tertiary); padding-top: var(--space-3); border-top: 1px dashed var(--border-color); }

  .work-cta {
    margin-top: clamp(var(--space-8), 5vw, var(--space-12));
    display: grid; gap: var(--space-6); align-items: center;
    border-left: 2px solid var(--accent);
  }
  @media (min-width: 900px) { .work-cta { grid-template-columns: 1.4fr 1fr; } }
  .work-cta-text { color: var(--text-secondary); line-height: 1.7; max-width: 56ch; }
  .work-cta-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  @media (min-width: 900px) { .work-cta-actions { justify-content: flex-end; } }
  .btn-cta {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 13px 22px; min-height: 44px;
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    text-decoration: none;
    transition: border-color var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }
  .btn-cta:hover { border-color: var(--accent); color: #fff; background: var(--accent); box-shadow: 0 0 14px var(--accent-glow); }
  .btn-cta.primary { border-color: var(--accent); color: var(--accent-text); }
  .btn-cta.primary:hover { color: #fff; }

  /* ── Skills ──────────────────────────────────────────────────────────────── */
  .skills-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3rem);
  }
  @media (min-width: 768px) { .skills-grid { grid-template-columns: repeat(2, 1fr); gap: 3rem 4rem; } }
  .skills-grid.compact { gap: 1.5rem 3rem; }
  .skills-secondary {
    margin-top: clamp(var(--space-12), 6vw, var(--space-16));
    padding-top: var(--space-8);
    border-top: 1px dashed var(--border-color);
  }

  .skill-group-head { display: flex; align-items: baseline; gap: 14px; margin-bottom: 1rem; }
  .skill-group-head::after { content: ''; flex: 1; height: 1px; background: var(--border-color); opacity: 0.6; align-self: center; }
  .skill-group-title { font-size: 0.8rem; font-weight: 900; letter-spacing: 0.16em; color: var(--text-primary); text-transform: uppercase; }
  .skill-group-count { font-size: 0.75rem; color: var(--accent-text); letter-spacing: 0.08em; }
  .skill-group-note { font-size: 0.8rem; color: var(--text-secondary); margin: -0.25rem 0 0.9rem; line-height: 1.6; }
  .skill-chips { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 0; }
  .skill-chip {
    display: inline-flex; align-items: center;
    padding: 8px 14px;
    font-size: 0.75rem; letter-spacing: 0.04em;
    color: var(--text-secondary);
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    transition: border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }
  .skill-chip.small { padding: 6px 11px; font-size: 0.7rem; color: var(--text-tertiary); }
  .skill-chip:hover { border-color: var(--accent); color: #fff; background: rgba(196,30,58,0.12); }
</style>

<script>
  /* Crimson hero name scramble + chromatic aberration */
  (function nameReveal() {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const SCRAMBLE = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#@&%*+={}<>/';

    type Span = { el: HTMLSpanElement; final: string };

    // Glyph spans are server-rendered (see the h1 markup) so the DOM never
    // restructures on load — that restructuring was a measurable layout shift.
    function splitInto(node: HTMLElement): Span[] {
      return Array.from(node.querySelectorAll<HTMLSpanElement>('.ch')).map((el) => ({ el, final: el.dataset.ch || '' }));
    }

    function scramble(spans: Span[], baseDelay: number) {
      const DUR = 1000, STG = 55, TICK = 45;
      spans.forEach((s, idx) => {
        if (s.final === ' ') return;
        const start = baseDelay + idx * STG;
        setTimeout(() => {
          const resolveAtAbs = performance.now() + DUR;
          const interval = setInterval(() => {
            if (performance.now() >= resolveAtAbs) {
              clearInterval(interval);
              s.el.textContent = s.final;
              return;
            }
            s.el.textContent = SCRAMBLE[Math.floor(Math.random() * SCRAMBLE.length)];
          }, TICK);
        }, start);
      });
      return baseDelay + (spans.length - 1) * STG + DUR;
    }

    const ln1 = document.getElementById('ln1');
    const ln2 = document.getElementById('ln2');
    if (!ln1 || !ln2) return;
    // Under reduced motion the server-rendered text stays as-is: no scramble.
    if (reduced) {
      document.getElementById('name-wrap')?.classList.add('framed');
      return;
    }
    const ln1Spans = splitInto(ln1);
    const ln2Spans = splitInto(ln2);
    // Lock every glyph box to its final width (measured once, before any
    // scrambling) so the random characters cannot cause layout shift.
    for (const s of [...ln1Spans, ...ln2Spans]) {
      if (s.final === ' ') continue;
      s.el.style.width = s.el.getBoundingClientRect().width + 'px';
    }

    scramble(ln1Spans, 0);
    const e2 = scramble(ln2Spans, 100);
    setTimeout(() => {
      ln2.classList.add('aberrate');
      setTimeout(() => ln2.classList.remove('aberrate'), 700);
      document.getElementById('name-wrap')?.classList.add('framed');
    }, e2 + 40);

    ln2.addEventListener('mouseenter', () => {
      if (ln2.classList.contains('aberrate')) return;
      ln2.classList.add('aberrate');
      setTimeout(() => ln2.classList.remove('aberrate'), 650);
    });
  })();

  /* Status typewriter */
  (function statusTypewriter() {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const el = document.getElementById('hero-status');
    if (!el) return;
    const TARGET = (el.textContent || '').trim(); // rendered from content.json → hero.status
    if (reduced) { el.textContent = TARGET; return; }

    const TOTAL = 600;
    // Reserve the final width (+ caret) so the pill doesn't grow while typing.
    el.style.display = 'inline-block';
    el.style.minWidth = Math.ceil(el.getBoundingClientRect().width + 9) + 'px';
    el.style.textAlign = 'left';
    el.textContent = '';
    let i = 0;
    function tick() {
      i++;
      el!.textContent = TARGET.slice(0, i);
      if (i < TARGET.length) {
        const dt = TOTAL / TARGET.length + (Math.random() - 0.5) * 18;
        setTimeout(tick, dt);
      } else {
        const caret = document.createElement('span');
        caret.className = 'caret';
        el!.parentElement?.appendChild(caret);
      }
    }
    setTimeout(tick, 400);
  })();

  /* Cinematic load sequence (content is never delayed by more than ~400ms
     after the name resolves; CTAs are in the DOM and focusable throughout) */
  (function loadSequence() {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const $ = (id: string) => document.getElementById(id);
    const els = { status: $('hero-status-wrap'), sub: $('hero-subtitle'), ctas: $('hero-ctas'), cue: $('scroll-cue') };
    if (reduced) {
      Object.values(els).forEach((e) => e?.classList.add('in'));
      return;
    }
    setTimeout(() => els.status?.classList.add('in'), 300);
    setTimeout(() => els.sub?.classList.add('in'), 1200);
    setTimeout(() => els.ctas?.classList.add('in'), 1350);
    setTimeout(() => els.cue?.classList.add('in'), 1700);
  })();
</script>
