---
// ════════════════════════════════════════════════════════════════════════════
//  UNLISTED VISITOR GALLERY
//
//  Unguessable static route: /gallery-088c0fbff746/
//  Link-based privacy, NOT authentication — anyone with the URL can view and
//  submit. Kept out of search engines via Layout's `noindex` prop, excluded
//  from any sitemap, and not linked from any public page (the header nav link
//  was removed). Share the URL directly with people you want drawing here.
// ════════════════════════════════════════════════════════════════════════════
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Swatches: hex + human name (the name feeds aria-labels and the live status line).
const COLORS: [string, string][] = [
  ['#222222', 'Ink black'], ['#FFFFFF', 'White'], ['#C41E3A', 'Crimson'], ['#00E5FF', 'Cyan'],
  ['#FF0055', 'Hot pink'], ['#FF6B2C', 'Orange'], ['#FFD700', 'Gold'], ['#00C853', 'Green'],
  ['#2196F3', 'Blue'], ['#9C27B0', 'Purple'], ['#8B4513', 'Brown'], ['#FFCD94', 'Peach'], ['#FF69B4', 'Pink'],
];
---

<Layout
  title="VISITOR GALLERY"
  description="An unlisted drawing wall: sketch something on the canvas and transmit it to the neural archive."
  noindex={true}
>
  <Header />

  <main class="vg" style="padding-top: 80px;">

    <!-- ═══ PAGE HEADER ══════════════════════════════════════════════════════ -->
    <section class="vg-section vg-head">
      <div class="max-w-7xl mx-auto">
        <p class="font-mono text-xs mb-3 vg-eyebrow">NEURAL_ARCHIVE /</p>
        <div class="flex items-end gap-4">
          <h1 class="font-black kinetic-text vg-h1">
            VISITOR<br/><span style="color:var(--accent);">GALLERY</span>
          </h1>
          <div class="flex-1 h-px" style="background:var(--border-color); margin-bottom:0.5rem;"></div>
          <span id="artwork-count" class="font-black font-mono text-xl" style="color:var(--text-secondary); margin-bottom:0.4rem;" aria-label="Number of works">/--</span>
        </div>
        <p class="font-mono text-xs mt-4 vg-dim">
          &gt; DRAW_TOOL_ACTIVE — SUBMIT YOUR CREATION TO THE NEURAL ARCHIVE
        </p>
      </div>
    </section>

    <!-- ═══ DRAW + SUBMIT ════════════════════════════════════════════════════ -->
    <section class="vg-section">
      <div class="max-w-7xl mx-auto">
        <div class="vg-grid">

          <!-- LEFT: Canvas -->
          <div class="panel vg-panel" id="canvas-panel">
            <p class="font-mono text-xs mb-4 vg-eyebrow">01 / DRAW_YOUR_ART.exe</p>

            <p class="vg-hint font-mono" id="tool-hint">
              BRUSH paints · ERASER wipes · FILL floods a region · S / M / L set stroke width · UNDO steps back (20) · ⛶ goes fullscreen
            </p>

            <!-- Toolbar (moves into the fullscreen overlay together with the canvas) -->
            <div id="canvas-toolbar" class="toolbar-row" role="toolbar" aria-label="Drawing tools" aria-describedby="tool-hint">
              <div class="toolbar-group" role="group" aria-label="Tool">
                <button type="button" class="tool-btn font-mono" data-tool="brush" aria-pressed="true">BRUSH</button>
                <button type="button" class="tool-btn font-mono" data-tool="eraser" aria-pressed="false">ERASER</button>
                <button type="button" class="tool-btn font-mono" data-tool="fill" aria-pressed="false" title="Bucket fill">FILL</button>
              </div>

              <div class="toolbar-group toolbar-colors" role="group" aria-label="Colour">
                {COLORS.map(([hex, name], i) => (
                  <button type="button" class="color-btn" data-color={hex} data-name={name}
                    style={`--c:${hex}`} aria-label={`Colour: ${name}`} aria-pressed={i === 0 ? 'true' : 'false'}></button>
                ))}
              </div>

              <div class="toolbar-group" role="group" aria-label="Stroke size">
                <button type="button" class="size-btn font-mono" data-size="s" aria-label="Size: small" aria-pressed="false">S</button>
                <button type="button" class="size-btn font-mono" data-size="m" aria-label="Size: medium" aria-pressed="true">M</button>
                <button type="button" class="size-btn font-mono" data-size="l" aria-label="Size: large" aria-pressed="false">L</button>
              </div>

              <div class="toolbar-group" role="group" aria-label="Canvas actions">
                <button type="button" id="undo-btn" class="tool-btn font-mono" disabled aria-label="Undo last stroke">UNDO</button>
                <button type="button" id="clear-btn" class="clear-btn font-mono" aria-label="Clear the canvas">CLEAR</button>
                <button type="button" id="fullscreen-btn" class="fs-btn font-mono" aria-label="Fullscreen canvas" aria-pressed="false">⛶</button>
              </div>
            </div>

            <div id="canvas-wrap" class="canvas-wrap">
              <canvas id="drawing-canvas" width="600" height="390" role="img"
                aria-label="Drawing canvas, 600 by 390 pixels. Draw with a mouse, finger or pen; use the toolbar buttons to change tool, colour and size."
                aria-describedby="canvas-status"></canvas>
            </div>

            <p id="canvas-status" class="font-mono text-xs mt-3 vg-dim" aria-live="polite">BRUSH · 8px · Ink black</p>
          </div>

          <!-- RIGHT: Submit Form -->
          <div class="panel vg-panel">
            <p class="font-mono text-xs mb-5 vg-eyebrow">02 / TRANSMIT_TO_ARCHIVE.exe</p>

            <!-- Success state -->
            <div id="success-box" hidden style="text-align:center; padding:4rem 0;" role="status">
              <div class="transmitted-anim font-black font-mono" style="font-size:2rem; color:var(--accent); letter-spacing:0.08em;">TRANSMITTED</div>
              <p class="font-mono text-sm mt-3" style="color:var(--text-secondary);">Your artwork is now in the archive.</p>
              <button type="button" id="draw-another-btn" class="mt-8 font-mono text-xs font-bold px-6 py-3 cut-corner another-btn" style="letter-spacing:0.1em;">DRAW ANOTHER</button>
            </div>

            <!-- Form -->
            <form id="submit-form" novalidate>
              <div id="setup-warning" hidden class="vg-notice" role="status">
                <span style="color:var(--accent);">SUPABASE NOT CONFIGURED</span><br/>
                Add <code>PUBLIC_SUPABASE_URL</code> and <code>PUBLIC_SUPABASE_ANON_KEY</code> to <code>.env</code> to enable submissions.
              </div>

              <div class="vg-field">
                <label for="inp-name" class="font-mono text-xs vg-label">YOUR NAME <span class="vg-dim">(max 60)</span></label>
                <input id="inp-name" name="name" type="text" maxlength="60" required autocomplete="nickname" placeholder="e.g. Anonymous" class="gallery-input" />
              </div>

              <div class="vg-field">
                <label for="inp-title" class="font-mono text-xs vg-label">ARTWORK TITLE <span class="vg-dim">(max 80)</span></label>
                <input id="inp-title" name="title" type="text" maxlength="80" required autocomplete="off" placeholder="e.g. Untitled #01" class="gallery-input" />
              </div>

              <!-- Honeypot: invisible to people, tempting to bots. Never submitted to the DB. -->
              <div class="vg-hp" aria-hidden="true">
                <label for="inp-website">Website</label>
                <input id="inp-website" name="website" type="text" tabindex="-1" autocomplete="off" />
              </div>

              <!-- Preview -->
              <div class="vg-field">
                <p class="font-mono text-xs vg-label" id="preview-label">PREVIEW</p>
                <div class="preview-box" aria-labelledby="preview-label">
                  <img id="preview-img" alt="Preview of your drawing" hidden />
                  <span id="preview-empty" class="font-mono text-xs vg-dim">DRAW SOMETHING FIRST</span>
                </div>
              </div>

              <!-- Error (announced politely; graceful retry UI) -->
              <div class="err-box" id="err-box" hidden role="alert" aria-live="polite">
                <span class="err-title">TRANSMISSION FAILED</span>
                <div class="err-body" id="err-body">Could not reach the archive server. Check your connection and try again.</div>
                <div class="err-actions">
                  <button class="err-btn" id="err-retry" type="button">RETRY ↻</button>
                  <button class="err-btn ghost" id="err-dismiss" type="button">DISMISS</button>
                </div>
              </div>

              <button id="submit-btn" type="submit" class="submit-btn font-mono text-sm font-bold py-4 cut-corner" style="width:100%; letter-spacing:0.1em;">
                <span id="submit-text">SUBMIT TO GALLERY</span>
                <span id="submit-spin" hidden>TRANSMITTING...</span>
              </button>

              <p class="font-mono text-xs mt-4 vg-dim" style="letter-spacing:0.06em;">
                All submissions are public and visible to everyone. One transmission per 30 s.
              </p>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ GALLERY (single mosaic) ══════════════════════════════════════════ -->
    <section id="gallery-section" class="vg-section" style="border-top:1px solid var(--border-color);" aria-labelledby="archive-title">
      <div class="max-w-7xl mx-auto">
        <div class="archive-head">
          <p class="file font-mono">ARCHIVE /</p>
          <h2 id="archive-title" class="font-black kinetic-text">ALL WORKS</h2>
          <div class="line"></div>
          <p class="count font-mono"><span id="archive-count">00</span> ENTRIES</p>
        </div>

        <!-- Loading skeleton -->
        <div id="gallery-loading" class="archive-grid" aria-busy="true" aria-label="Loading submissions">
          <div class="skeleton-tile"></div><div class="skeleton-tile"></div><div class="skeleton-tile"></div>
          <div class="skeleton-tile"></div><div class="skeleton-tile"></div><div class="skeleton-tile"></div>
        </div>

        <!-- Error -->
        <div id="gallery-error" class="vg-state vg-state-error" hidden role="alert">
          <p class="vg-state-code font-mono">ERR_ARCHIVE_UNREACHABLE</p>
          <p class="vg-state-title">The archive server did not answer.</p>
          <p class="vg-state-body font-mono">Your connection may be offline, or the archive is briefly down. Nothing you drew is lost — the canvas stays as it is.</p>
          <button type="button" id="gallery-retry" class="vg-state-btn font-mono cut-corner-sm">RETRY ↻</button>
        </div>

        <!-- Empty -->
        <div id="gallery-empty" class="vg-state" hidden role="status">
          <p class="vg-state-code font-mono">0 ENTRIES · ARCHIVE_EMPTY</p>
          <p class="vg-state-title">BE THE FIRST TO SUBMIT<span class="blink-cursor" aria-hidden="true">_</span></p>
          <p class="vg-state-body font-mono">Nothing has been transmitted yet. Draw something above and your piece becomes entry 01.</p>
          <a href="#canvas-panel" class="vg-state-btn font-mono cut-corner-sm">GO TO CANVAS ↑</a>
        </div>

        <!-- Mosaic -->
        <div id="archive-grid" class="archive-grid" hidden></div>
      </div>
    </section>

    <!-- Lightbox -->
    <dialog id="lightbox" class="lightbox" aria-labelledby="lb-title">
      <div class="lb-inner">
        <button type="button" id="lb-close" class="lb-close font-mono" aria-label="Close">✕ CLOSE</button>
        <img id="lb-img" alt="" width="600" height="390" />
        <div class="lb-meta">
          <p id="lb-title" class="lb-title"></p>
          <p class="font-mono text-xs"><span id="lb-author" style="color:var(--text-secondary);"></span> <span id="lb-date" class="vg-dim" style="margin-left:0.75rem;"></span></p>
        </div>
      </div>
    </dialog>

    <!-- Fullscreen overlay: toolbar + canvas are moved in here (same nodes, same state) -->
    <div id="fs-overlay" class="fs-overlay" hidden role="dialog" aria-modal="true" aria-label="Fullscreen drawing canvas">
      <p class="font-mono text-xs vg-eyebrow" style="margin:0 0 0.5rem;">FULLSCREEN — press EXIT or Esc to return</p>
      <div id="fs-slot" class="fs-slot"></div>
    </div>

  </main>
  <Footer />
</Layout>

<script>
  import '../scripts/gallery-page';
</script>

<!-- Global on purpose: tiles / lightbox contents are built in JS and would not carry Astro's scope attribute. -->
<style is:global>
  .vg [hidden] { display: none !important; }
  .vg-section { padding: var(--space-12) var(--gutter); }
  .vg-head { padding-top: var(--space-12); padding-bottom: var(--space-8); border-bottom: 1px solid var(--border-color); }
  .vg-h1 { font-family: 'Space Grotesk', sans-serif; font-size: clamp(3rem, 9vw, 7rem); color: var(--text-primary); line-height: 0.9; }
  .vg-eyebrow { color: var(--text-secondary); letter-spacing: 0.15em; }
  .vg-dim { color: var(--text-tertiary); letter-spacing: 0.08em; }
  .vg-panel { padding: clamp(1rem, 4vw, 2rem); min-width: 0; }
  .vg-hint { font-size: 0.65rem; line-height: 1.7; color: var(--text-tertiary); letter-spacing: 0.06em; margin-bottom: var(--space-3); }
  .vg-notice {
    padding: 0.75rem 1rem; margin-bottom: 1.5rem; background: var(--bg-elevated); border: 1px solid var(--border-color);
    font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; color: var(--text-secondary); line-height: 1.8;
  }
  .vg-notice code { color: var(--text-primary); }

  /* ── Layout ──────────────────────────────────────────────────────────────── */
  .vg-grid { display: grid; gap: 2rem; min-width: 0; }
  @media (min-width: 1024px) { .vg-grid { grid-template-columns: 1fr 1fr; align-items: start; } }

  /* ── Toolbar ─────────────────────────────────────────────────────────────── */
  .toolbar-row { display: flex; flex-wrap: wrap; gap: 0.6rem 0.75rem; margin-bottom: 1rem; align-items: center; min-width: 0; }
  .toolbar-group { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
  .toolbar-colors { gap: 0.45rem; }

  .tool-btn, .size-btn, .clear-btn, .fs-btn {
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; padding: 0.45rem 0.8rem; min-height: 32px;
    background: transparent; color: var(--text-primary); border: 1px solid var(--border-color);
    cursor: pointer; transition: background var(--dur-fast), color var(--dur-fast), border-color var(--dur-fast);
    clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);
  }
  .size-btn { min-width: 32px; padding-inline: 0.5rem; text-align: center; }
  .tool-btn:hover, .size-btn:hover { border-color: var(--text-secondary); }
  .tool-btn.is-active, .size-btn.is-active { background: var(--accent); color: #fff; border-color: var(--accent); }
  .tool-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .clear-btn { color: #FF0055; border-color: #FF0055; }
  .clear-btn:hover { background: #FF0055; color: #0a0a0a; }
  .fs-btn { color: var(--text-secondary); font-size: 0.9rem; padding-inline: 0.6rem; }
  .fs-btn:hover, .fs-btn.is-active { border-color: var(--accent); color: var(--accent); }
  /* clip-path clips the outline; use an inset ring for focus instead */
  .toolbar-row button:focus-visible { outline: none; box-shadow: inset 0 0 0 2px var(--accent-bri), 0 0 0 2px var(--accent-bri); }

  .color-btn {
    width: 24px; height: 24px; border-radius: 50%; border: 2px solid transparent; padding: 0;
    background: var(--c); cursor: pointer; transition: transform var(--dur-fast), box-shadow var(--dur-fast);
    box-shadow: 0 0 0 1px var(--border-color);
  }
  .color-btn:hover { transform: scale(1.2); }
  .color-btn.is-active { transform: scale(1.3); box-shadow: 0 0 0 2px var(--accent), 0 0 8px rgba(196,30,58,0.55); }
  .color-btn:focus-visible { outline: 2px solid var(--accent-bri); outline-offset: 3px; box-shadow: 0 0 0 1px var(--border-color); }

  .canvas-wrap { position: relative; min-width: 0; }
  #drawing-canvas {
    width: 100%; height: auto; display: block; cursor: crosshair; touch-action: none;
    border: 1px solid var(--border-color); box-shadow: inset 0 0 30px rgba(0,0,0,0.5); background: #fff;
  }
  #drawing-canvas.cursor-fill { cursor: cell; }

  /* ── Fullscreen overlay ──────────────────────────────────────────────────── */
  .fs-overlay { position: fixed; inset: 0; z-index: 9999; background: var(--bg-base); display: flex; flex-direction: column; padding: 0.75rem; }
  .fs-slot { flex: 1; display: flex; flex-direction: column; min-height: 0; }
  .fs-slot .toolbar-row { flex-shrink: 0; }
  .fs-slot .canvas-wrap { flex: 1; display: flex; align-items: center; justify-content: center; min-height: 0; }
  .fs-slot #drawing-canvas { width: min(100%, calc((100dvh - 150px) * 1.538)); max-height: 100%; }
  body.vg-fs-lock { overflow: hidden; }

  /* ── Form ─────────────────────────────────────────────────────────────────── */
  .vg-field { margin-bottom: 1.5rem; }
  .vg-label { display: block; margin-bottom: 0.5rem; color: var(--text-secondary); letter-spacing: 0.12em; }
  .gallery-input {
    width: 100%; font-family: 'JetBrains Mono', monospace; font-size: 0.85rem;
    background: var(--bg-elevated); border: 1px solid var(--border-color); color: var(--text-primary);
    padding: 0.75rem 1rem; outline: none; letter-spacing: 0.04em; transition: border-color var(--dur-base), box-shadow var(--dur-base);
  }
  .gallery-input:focus { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
  .gallery-input::placeholder { color: var(--text-tertiary); }
  .vg-hp { position: absolute; left: -10000px; top: auto; width: 1px; height: 1px; overflow: hidden; }

  .preview-box { border: 1px solid var(--border-color); background: var(--bg-elevated); height: 120px; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .preview-box img { width: 100%; height: 120px; object-fit: cover; }

  .err-box {
    font-family: 'JetBrains Mono', monospace; font-size: 11px; padding: 12px 14px; margin-bottom: 14px;
    background: rgba(255,0,85,0.07); border: 1px solid #FF0055; color: #FF0055; line-height: 1.6; position: relative;
  }
  .err-box.show { animation: errShake .35s ease; }
  .err-box::before { content: '!'; display: inline-block; width: 18px; height: 18px; margin-right: 10px; border: 1px solid #FF0055; text-align: center; font-weight: 800; vertical-align: middle; }
  .err-box .err-title { font-weight: 700; letter-spacing: 0.12em; }
  .err-box .err-body { margin: 8px 0 12px 28px; }
  .err-box .err-actions { margin-left: 28px; display: flex; gap: 8px; }
  .err-box .err-btn { font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 700; letter-spacing: 0.12em; padding: 6px 12px; background: #FF0055; color: #0a0a0a; border: 1px solid #FF0055; cursor: pointer; }
  .err-box .err-btn.ghost { background: transparent; color: #FF0055; }
  .err-box .err-btn:hover { background: #0a0a0a; color: #FF0055; }
  @keyframes errShake { 0%,100% { transform: translateX(0); } 20% { transform: translateX(-4px); } 40% { transform: translateX(4px); } 60% { transform: translateX(-2px); } 80% { transform: translateX(2px); } }

  .submit-btn { background: var(--accent); color: #fff; border: 1px solid var(--accent); cursor: pointer; transition: background var(--dur-base), color var(--dur-base), box-shadow var(--dur-base); }
  .submit-btn:hover:not(:disabled) { background: transparent; color: var(--accent); box-shadow: 0 0 16px var(--accent-glow); }
  .submit-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .another-btn { background: transparent; color: var(--accent); border: 1px solid var(--accent); cursor: pointer; transition: background var(--dur-base), color var(--dur-base); }
  .another-btn:hover { background: var(--accent); color: #fff; }

  @keyframes transmitted-in {
    0%   { opacity: 0; transform: skewX(-5deg) scale(0.9); text-shadow: -3px 0 #00E5FF, 3px 0 #FF0055; }
    50%  { opacity: 1; transform: skewX(2deg) scale(1.03); text-shadow: 2px 0 #00E5FF, -2px 0 #FF0055; }
    100% { opacity: 1; transform: none; text-shadow: 0 0 20px rgba(196,30,58,0.35); }
  }
  .transmitted-anim { animation: transmitted-in 0.6s var(--ease-out) forwards; }

  /* ── Archive mosaic ──────────────────────────────────────────────────────── */
  .archive-head { display: flex; align-items: end; gap: 16px; margin-bottom: 24px; flex-wrap: wrap; }
  .archive-head .file { font-size: 11px; color: var(--text-secondary); letter-spacing: 0.15em; align-self: center; }
  .archive-head h2 { font-family: 'Space Grotesk', sans-serif; font-size: clamp(28px, 4vw, 44px); letter-spacing: -0.01em; color: var(--text-primary); }
  .archive-head .line { flex: 1; height: 1px; background: var(--border-color); min-width: 40px; }
  .archive-head .count { font-size: 13px; color: var(--text-secondary); letter-spacing: 0.1em; align-self: center; }
  .archive-head .count span { color: var(--text-primary); font-weight: 700; }

  .archive-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
  .archive-tile {
    position: relative; aspect-ratio: 600 / 390; border: 1px solid var(--border-color); background: #fff; overflow: hidden; padding: 0;
    cursor: zoom-in; display: block; width: 100%; text-align: left;
    transition: transform var(--dur-base) var(--ease-out), border-color var(--dur-base), box-shadow var(--dur-base);
  }
  .archive-tile:hover, .archive-tile:focus-visible { transform: scale(1.05); border-color: var(--accent); box-shadow: 0 0 24px var(--accent-glow); z-index: 5; }
  .archive-tile:focus-visible { outline: 2px solid var(--accent-bri); outline-offset: 2px; }
  .archive-tile img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .archive-tile .ovl {
    position: absolute; inset: 0; background: linear-gradient(180deg, transparent 45%, rgba(0,0,0,0.92));
    opacity: 0; transition: opacity var(--dur-fast); display: flex; flex-direction: column; justify-content: end; padding: 10px;
  }
  .archive-tile:hover .ovl, .archive-tile:focus-visible .ovl { opacity: 1; }
  .archive-tile .ovl .t { font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 800; color: var(--accent-bri); letter-spacing: 0.06em; line-height: 1.2; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .archive-tile .ovl .a { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: #ddd; margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .archive-tile .date { position: absolute; top: 4px; right: 6px; font-family: 'JetBrains Mono', monospace; font-size: 8px; color: #fff; background: rgba(0,0,0,0.7); padding: 1px 5px; }

  @keyframes skpulse { 0%,100% { opacity: 0.35; } 50% { opacity: 0.7; } }
  .skeleton-tile { aspect-ratio: 600 / 390; background: var(--bg-surface); border: 1px solid var(--border-color); animation: skpulse 1.5s ease-in-out infinite; }

  /* ── Empty / error states ────────────────────────────────────────────────── */
  .vg-state {
    position: relative; border: 1px solid var(--border-color); background: var(--bg-surface); padding: clamp(2rem, 6vw, 4rem) clamp(1.25rem, 5vw, 3rem);
    text-align: center; max-width: 720px; margin: 0 auto;
    background-image: linear-gradient(var(--border-color) 1px, transparent 1px), linear-gradient(90deg, var(--border-color) 1px, transparent 1px);
    background-size: 32px 32px; background-position: center;
  }
