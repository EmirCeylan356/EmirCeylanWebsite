    </div>
  </div>

  <Footer />
</Layout>

<style>
  /* ── Tab navigation ──────────────────────────────────────────────────────── */
  .tab-btn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--text-secondary);
