</style>

<script>
  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const FINE    = window.matchMedia('(pointer: fine)').matches;

  // ── Tabs (real tablist: arrow keys, aria-selected, hidden panels) ─────────
  (() => {
    const nav     = document.querySelector<HTMLElement>('#activities .tab-nav');
    const ind     = document.getElementById('tab-indicator');
    const content = document.getElementById('tab-content');
    if (!nav || !ind || !content) return;
    const tabs   = Array.from(nav.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(content.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

    const moveIndicator = (btn: HTMLElement) => {
      const r = btn.getBoundingClientRect();
      const navR = nav.getBoundingClientRect();
      ind.style.width = `${r.width}px`;
      ind.style.transform = `translateX(${r.left - navR.left + nav.scrollLeft}px)`;
    };

    const activate = (name: string, focus = false) => {
      const btn = tabs.find((b) => b.dataset.tab === name);
      if (!btn) return;
      tabs.forEach((b) => {
        const on = b === btn;
        b.setAttribute('aria-selected', on ? 'true' : 'false');
        b.tabIndex = on ? 0 : -1;
      });
      if (focus) btn.focus();
      moveIndicator(btn);

      panels.forEach((p) => {
        const on = p.dataset.panel === name;
        const wasHidden = p.hidden;
        p.hidden = !on;
        p.classList.remove('entering');
        if (on && wasHidden && !REDUCED) {
          void p.offsetHeight;
          p.classList.add('entering');
          p.addEventListener('animationend', () => p.classList.remove('entering'), { once: true });
        }
      });
      if (name === 'art') window.dispatchEvent(new Event('art:shown'));
    };

    tabs.forEach((b) => b.addEventListener('click', () => activate(b.dataset.tab ?? '')));
    nav.addEventListener('keydown', (e: KeyboardEvent) => {
      const i = tabs.findIndex((b) => b === document.activeElement);
      if (i < 0) return;
      let next = -1;
      if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
      else if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = tabs.length - 1;
      if (next < 0) return;
      e.preventDefault();
      activate(tabs[next].dataset.tab ?? '', true);
    });

    const current = () => tabs.find((b) => b.getAttribute('aria-selected') === 'true') ?? tabs[0];
    requestAnimationFrame(() => moveIndicator(current()));
    window.addEventListener('resize', () => moveIndicator(current()));
    if (document.fonts?.ready) document.fonts.ready.then(() => moveIndicator(current()));
  })();

  // ── Gallery: native horizontal scroll + wheel/drag/keys, eased via rAF ────
  (() => {
    const viewport = document.getElementById('art-viewport');
    const track    = document.getElementById('art-track');
    const bgLayer  = document.getElementById('art-bg');
    const progress = document.getElementById('art-progress');
    if (!viewport || !track) return;

    const maxX = () => Math.max(0, viewport.scrollWidth - viewport.clientWidth);
    const clamp = (x: number) => Math.max(0, Math.min(maxX(), x));

    let targetX = 0;
    let rafId = 0;

    const paint = () => {
      const x = viewport.scrollLeft;
      const m = maxX();
      if (progress) progress.style.width = `${m > 0 ? (x / m) * 100 : 0}%`;
      if (bgLayer && !REDUCED) bgLayer.style.transform = `translateX(${x * 0.2 - x}px)`;
      else if (bgLayer) bgLayer.style.transform = `translateX(${-x}px)`;
    };

    // The rAF loop only runs while there is distance left to cover.
    const step = () => {
      const cur = viewport.scrollLeft;
      const diff = targetX - cur;
      if (Math.abs(diff) <= 0.1) { viewport.scrollLeft = targetX; rafId = 0; return; }
      viewport.scrollLeft = cur + diff * 0.14;
      rafId = requestAnimationFrame(step);
    };
    const scrollTo = (x: number) => {
      targetX = clamp(x);
      if (REDUCED) { viewport.scrollLeft = targetX; return; }
      if (!rafId) rafId = requestAnimationFrame(step);
    };
    const stopEase = () => { if (rafId) cancelAnimationFrame(rafId); rafId = 0; targetX = viewport.scrollLeft; };

    viewport.addEventListener('scroll', paint, { passive: true });
    window.addEventListener('resize', () => { targetX = clamp(targetX); paint(); });
    window.addEventListener('art:shown', paint);

    // Vertical wheel → horizontal travel, but let the page scroll once we hit an edge.
    viewport.addEventListener('wheel', (e: WheelEvent) => {
      const delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
      const base = rafId ? targetX : viewport.scrollLeft;
      const atEdge = (delta > 0 && base >= maxX() - 1) || (delta < 0 && base <= 1);
      if (atEdge) return;
      e.preventDefault();
      scrollTo(base + delta * 1.3);
    }, { passive: false });

    // Keyboard: the viewport itself is focusable; arrows page through the wall.
    viewport.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.target !== viewport) return;
      const stepPx = 340;
      if (e.key === 'ArrowRight') { e.preventDefault(); scrollTo((rafId ? targetX : viewport.scrollLeft) + stepPx); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); scrollTo((rafId ? targetX : viewport.scrollLeft) - stepPx); }
      else if (e.key === 'Home') { e.preventDefault(); scrollTo(0); }
      else if (e.key === 'End') { e.preventDefault(); scrollTo(maxX()); }
    });

    // Mouse drag (touch uses native scrolling).
    let dragging = false, dragged = false, startX = 0, startScroll = 0;
    viewport.addEventListener('pointerdown', (e: PointerEvent) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      stopEase();
      dragging = true; dragged = false;
      startX = e.clientX; startScroll = viewport.scrollLeft;
      viewport.classList.add('grabbing');
      viewport.setPointerCapture(e.pointerId);
    });
    viewport.addEventListener('pointermove', (e: PointerEvent) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 5) dragged = true;
      viewport.scrollLeft = startScroll - dx;
    });
    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      viewport.classList.remove('grabbing');
      targetX = viewport.scrollLeft;
    };
    viewport.addEventListener('pointerup', endDrag);
    viewport.addEventListener('pointercancel', endDrag);
    // A drag must not open the lightbox when it ends over a card.
    viewport.addEventListener('click', (e: MouseEvent) => {
      if (dragged) { e.stopPropagation(); e.preventDefault(); dragged = false; }
    }, true);

    paint();
  })();

  // ── Gallery: directional cursor + 3D tilt + glare (fine pointer, motion ok)
  (() => {
    const vport  = document.getElementById('art-viewport');
    const cursor = document.getElementById('art-cursor');
    if (!vport || !cursor || !FINE || REDUCED) return;

    const lbl = cursor.querySelector<HTMLElement>('.lbl');
    vport.addEventListener('pointerenter', () => cursor.classList.add('active'));
    vport.addEventListener('pointerleave', () => cursor.classList.remove('active'));
    vport.addEventListener('pointermove', (e: PointerEvent) => {
      cursor.style.left = `${e.clientX}px`;
      cursor.style.top  = `${e.clientY}px`;
      const r = vport.getBoundingClientRect();
      const xrel = (e.clientX - r.left) / r.width;
      cursor.classList.toggle('flip', xrel < 0.5);
      if (lbl) lbl.textContent = xrel < 0.5 ? '← PREV' : 'NEXT →';
    });

    document.querySelectorAll<HTMLElement>('.art-item').forEach((card) => {
      const frame = card.querySelector<HTMLElement>('.art-frame');
      const glare = card.querySelector<HTMLElement>('.glare');
      if (!frame) return;
      card.addEventListener('pointermove', (e: PointerEvent) => {
        const r = frame.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width;
        const py = (e.clientY - r.top)  / r.height;
        frame.style.transform = `rotateX(${(py - 0.5) * -16}deg) rotateY(${(px - 0.5) * 16}deg) translateZ(0)`;
        if (glare) {
          glare.style.setProperty('--gx', `${px * 100}%`);
          glare.style.setProperty('--gy', `${py * 100}%`);
        }
      });
      card.addEventListener('pointerleave', () => { frame.style.transform = ''; });
    });
  })();

  // ── Lightbox (<dialog>: focus trap, Esc, backdrop, prev/next, counter) ────
  (() => {
    interface LbItem { id: number; title: string; medium: string; year: number; alt: string; src: string; srcset: string; width: number; height: number; }
    const dataEl = document.getElementById('art-data');
    const lb = document.getElementById('art-lightbox') as HTMLDialogElement | null;
    const img     = document.getElementById('art-lb-img') as HTMLImageElement | null;
    const idEl    = document.getElementById('art-lb-id');
    const titleEl = document.getElementById('art-lb-title');
    const medEl   = document.getElementById('art-lb-medium');
    const yearEl  = document.getElementById('art-lb-year');
    const descEl  = document.getElementById('art-lb-desc');
    const counter = document.getElementById('art-lb-counter');
    const prevBtn = document.getElementById('art-lb-prev');
    const nextBtn = document.getElementById('art-lb-next');
    const closeBtn = document.getElementById('art-lb-close');
    if (!dataEl || !lb || !img || !idEl || !titleEl || !medEl || !yearEl || !descEl || !counter || !prevBtn || !nextBtn || !closeBtn) return;
    if (typeof lb.showModal !== 'function') return; // very old browsers: cards stay plain buttons

    let items: LbItem[] = [];
    try { items = JSON.parse(dataEl.textContent || '[]') as LbItem[]; } catch { return; }
    if (!items.length) return;

    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.art-btn'));
    let index = 0;
    let opener: HTMLElement | null = null;

    const render = (i: number) => {
      index = (i + items.length) % items.length;
      const a = items[index];
      img.src = a.src;
      img.srcset = a.srcset;
      img.sizes = '(min-width: 768px) 620px, 100vw';
      img.width = a.width;
      img.height = a.height;
      img.alt = a.alt;
      idEl.textContent = `ARTWORK / ${String(a.id).padStart(2, '0')}`;
      titleEl.textContent = a.title;
      medEl.textContent = a.medium;
      yearEl.textContent = String(a.year);
      descEl.textContent = a.alt;
      counter.textContent = `${index + 1} / ${items.length}`;
      // Warm the neighbours so prev/next feel instant.
      [index + 1, index - 1].forEach((n) => {
        const nb = items[(n + items.length) % items.length];
        const pre = new Image(); pre.srcset = nb.srcset; pre.sizes = img.sizes; pre.src = nb.src;
      });
    };

    const open = (i: number, from: HTMLElement | null) => {
      opener = from;
      render(i);
      lb.showModal();
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    };

    lb.addEventListener('close', () => {
      document.body.style.overflow = '';
      img.removeAttribute('srcset'); img.removeAttribute('src');
      const target = opener ?? buttons[index] ?? null;
      opener = null;
      target?.focus({ preventScroll: false });
    });

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => open(Number(btn.dataset.index ?? 0), btn));
    });

    closeBtn.addEventListener('click', () => lb.close());
    prevBtn.addEventListener('click', () => render(index - 1));
    nextBtn.addEventListener('click', () => render(index + 1));
    lb.addEventListener('click', (e: MouseEvent) => { if (e.target === lb) lb.close(); });
    lb.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); render(index + 1); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); render(index - 1); }
    });
    // Keep the opener in sync when the user paged inside the dialog.
    lb.addEventListener('close', () => { opener = null; });
  })();
</script>
