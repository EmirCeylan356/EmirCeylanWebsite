---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import artworksData from '../data/artworks.json';

// ── Paintings live in src/assets/paintings and go through astro:assets ───────
const imageModules = import.meta.glob<{ default: ImageMetadata }>('../assets/paintings/*.{jpg,jpeg,png}', { eager: true });
const imageByName: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(imageModules)) {
  imageByName[path.split('/').pop() ?? path] = mod.default;
}

// ── Artworks — single source of truth (titles are Emir's; alt = what is visible)
interface Artwork {
  id: number;
  title: string;
  medium: string;
  year: number;
  status?: string;
  file: string;
  alt: string;
}

// Artworks are edited through the CMS (/admin/) and stored in src/data/artworks.json.
// `file` is the basename of an image in src/assets/paintings/ (the CMS may save a full path).
const artworks: Artwork[] = (artworksData.artworks as Artwork[]).map((a) => ({ ...a, file: a.file.split('/').pop() ?? a.file }));

const paintings = artworks.map((a) => {
  const img = imageByName[a.file];
  if (!img) throw new Error(`hobbies.astro: missing painting src/assets/paintings/${a.file}`);
  return { ...a, img };
});
const total = paintings.length;

// Large variants for the lightbox (webp, up to 1200w). Serialised once, below.
const lightboxData = await Promise.all(
  paintings.map(async (p) => {
    const big = await getImage({ src: p.img, widths: [640, 900, 1200], width: 1200, format: 'webp', quality: 70 });
    return {
      id: p.id, title: p.title, medium: p.medium, year: p.year, alt: p.alt,
      src: big.src, srcset: big.srcSet.attribute,
      width: Number(big.attributes.width), height: Number(big.attributes.height),
    };
  }),
);
const lightboxJson = JSON.stringify(lightboxData).replace(/</g, '\\u003c');

// ── TRAVELS — passport grid ───────────────────────────────────────────────────
// Country list confirmed by Emir (31 countries; Turkey = home base).
// `year` / `note` are optional — add per-country if you ever want them shown.
const countries = [
  { flag: '🇹🇷', iso: 'TR', name: 'Turkey',                  home: true, year: '', note: 'Home base — Istanbul' },
  { flag: '🇦🇱', iso: 'AL', name: 'Albania',                 year: '', note: '' },
  { flag: '🇦🇩', iso: 'AD', name: 'Andorra',                 year: '', note: '' },
  { flag: '🇧🇪', iso: 'BE', name: 'Belgium',                 year: '', note: '' },
  { flag: '🇧🇦', iso: 'BA', name: 'Bosnia and Herzegovina',  year: '', note: '' },
  { flag: '🇧🇬', iso: 'BG', name: 'Bulgaria',                year: '', note: '' },
  { flag: '🇭🇷', iso: 'HR', name: 'Croatia',                 year: '', note: '' },
  { flag: '🇨🇿', iso: 'CZ', name: 'Czech Republic',          year: '', note: '' },
  { flag: '🇫🇷', iso: 'FR', name: 'France',                  year: '', note: '' },
  { flag: '🇩🇪', iso: 'DE', name: 'Germany',                 year: '', note: '' },
  { flag: '🇬🇷', iso: 'GR', name: 'Greece',                  year: '', note: '' },
  { flag: '🇭🇺', iso: 'HU', name: 'Hungary',                 year: '', note: '' },
  { flag: '🇮🇹', iso: 'IT', name: 'Italy',                   year: '', note: '' },
  { flag: '🇯🇵', iso: 'JP', name: 'Japan',                   year: '', note: '' },
  { flag: '🇯🇴', iso: 'JO', name: 'Jordan',                  year: '', note: '' },
  { flag: '🇽🇰', iso: 'XK', name: 'Kosovo',                  year: '', note: '' },
  { flag: '🇱🇹', iso: 'LT', name: 'Lithuania',               year: '', note: '' },
  { flag: '🇲🇾', iso: 'MY', name: 'Malaysia',                year: '', note: '' },
  { flag: '🇳🇱', iso: 'NL', name: 'Netherlands',             year: '', note: '' },
  { flag: '🇲🇰', iso: 'MK', name: 'North Macedonia',         year: '', note: '' },
  { flag: '🇵🇱', iso: 'PL', name: 'Poland',                  year: '', note: '' },
  { flag: '🇵🇹', iso: 'PT', name: 'Portugal',                year: '', note: '' },
  { flag: '🇷🇴', iso: 'RO', name: 'Romania',                 year: '', note: '' },
  { flag: '🇷🇺', iso: 'RU', name: 'Russia',                  year: '', note: '' },
  { flag: '🇷🇸', iso: 'RS', name: 'Serbia',                  year: '', note: '' },
  { flag: '🇸🇰', iso: 'SK', name: 'Slovakia',                year: '', note: '' },
  { flag: '🇸🇮', iso: 'SI', name: 'Slovenia',                year: '', note: '' },
  { flag: '🇪🇸', iso: 'ES', name: 'Spain',                   year: '', note: '' },
  { flag: '🇨🇭', iso: 'CH', name: 'Switzerland',             year: '', note: '' },
  { flag: '🇹🇭', iso: 'TH', name: 'Thailand',                year: '', note: '' },
  { flag: '🇻🇳', iso: 'VN', name: 'Vietnam',                 year: '', note: '' },
];
const countryCount = countries.length;
const countryPadded = countryCount.toString().padStart(2, '0');

const tabs = [
  { id: 'sport', label: '[ SPORT ]' },
  { id: 'art',   label: '[ ART ]' },
  { id: 'think', label: '[ THINK ]' },
];
---

<Layout
  title="Hobbies"
  description={`What Emir Ceylan does off the clock: jiu-jitsu, archery and conditioning, a gallery of ${total} drawings and paintings, chess and books, and ${countryCount} countries visited.`}
  ogImage="/og/hobbies.png"
>
  <Header />

  <main class="flex-1 hobbies-main">

    <!-- ═══ ACTIVITIES — 3-tab interface ═════════════════════════════════════ -->
    <section id="activities" class="activities">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <p class="eyebrow font-mono">01 /</p>
          <h1 class="section-title kinetic-text">ACTIVITIES</h1>
          <div class="rule" aria-hidden="true"></div>
          <span class="section-count font-mono" data-counter="3" data-prefix="/" data-pad="2">/03</span>
        </div>

        <!-- Tab navigation -->
        <div class="tab-nav" role="tablist" aria-label="Activities">
          {tabs.map((t, i) => (
            <button
              class="tab-btn"
              type="button"
              role="tab"
              id={`tab-${t.id}-btn`}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`tab-${t.id}`}
              tabindex={i === 0 ? 0 : -1}
              data-tab={t.id}
            >{t.label}</button>
          ))}
          <div class="tab-indicator" id="tab-indicator" aria-hidden="true"></div>
        </div>
      </div>

      <div class="tab-content" id="tab-content">

      <!-- ── SPORT ────────────────────────────────────────────────────────── -->
      <div id="tab-sport" class="tab-panel" role="tabpanel" aria-labelledby="tab-sport-btn" data-panel="sport" tabindex="0">
        <div class="wrap panel-pad">
          <div class="grid md:grid-cols-2 gap-10 items-start">

            <div class="intro-card" data-reveal>
              <p class="eyebrow font-mono mb-4">PHYSICAL PRACTICE</p>
              <h2 class="panel-title accent">SPORT</h2>
              <p class="body-copy mb-5">
                None of this is professional — it's the physical stuff I've picked up along the way and kept around in some form.
              </p>
              <p class="body-copy">
                I trained Brazilian Jiu-Jitsu formally for a short stretch and still roll with friends now and then. Archery goes back further, to middle school. Conditioning is the daily baseline that keeps everything else moving.
              </p>
            </div>

            <div class="flex flex-col gap-4" data-reveal-stagger>
              <div class="hobby-card">
                <div class="flex items-center gap-4 mb-3">
                  <span class="font-mono text-2xl font-black accent">BJJ</span>
                  <span class="chip font-mono">CASUAL</span>
                </div>
                <p class="text-sm font-mono card-copy">Trained formally for about a month and a half. These days I mostly roll casually with friends when it comes up.</p>
              </div>

              <div class="hobby-card">
                <div class="flex items-center gap-4 mb-3">
                  <span class="font-mono text-2xl font-black accent">ARCHERY</span>
                  <span class="chip font-mono">CERTIFIED</span>
                </div>
                <p class="text-sm font-mono card-copy">Earned a certificate and competed in a few tournaments back in middle school.</p>
              </div>

              <div class="hobby-card">
                <div class="flex items-center gap-4 mb-3">
                  <span class="font-mono text-2xl font-black accent">CONDITIONING</span>
                  <span class="chip font-mono">DAILY</span>
                </div>
                <p class="text-sm font-mono card-copy">Strength and endurance work that supports everything else. Consistency over intensity. The goal is showing up tomorrow.</p>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- ── ART ──────────────────────────────────────────────────────────── -->
      <div id="tab-art" class="tab-panel is-surface" role="tabpanel" aria-labelledby="tab-art-btn" data-panel="art" tabindex="0" hidden>
        <div class="wrap panel-pad">
          <div class="grid md:grid-cols-2 gap-10 items-start art-intro">

            <div class="intro-card on-base" data-reveal>
              <p class="eyebrow font-mono mb-4">THE STUDIO</p>
              <h2 class="panel-title accent">OIL<br>PAINTING</h2>
              <p class="body-copy mb-5">
                I've been painting with oils since I was a teenager. There's something about a medium that dries slowly and demands commitment — you can't undo a stroke, you can only paint over it, and you carry every previous decision forward.
              </p>
              <p class="body-copy mb-5">
                Most of my work starts without a clear plan. I mix a color that feels right, make a mark, and respond to it. The discipline is in resisting the urge to over-explain — in painting, too much intention usually kills the thing you were trying to make.
              </p>
              <p class="body-copy">
                I work across oil, acrylic, charcoal, and mixed media. The gallery below is the work that made it past my own editing.
              </p>
            </div>

            <div class="flex flex-col gap-6" data-reveal-stagger>
              <div class="stat stat-accent">
                <div class="stat-num accent">{total}</div>
                <div class="stat-lbl font-mono">PIECES IN GALLERY</div>
              </div>
              <div class="stat">
                <div class="stat-num accent">OIL</div>
                <div class="stat-lbl font-mono">PRIMARY MEDIUM</div>
              </div>
              <div class="stat">
                <div class="stat-num muted">2020–</div>
                <div class="stat-lbl font-mono">ACTIVE PERIOD</div>
              </div>
            </div>

          </div>

          <!-- Gallery -->
          <p class="gallery-hint font-mono" id="art-hint">← DRAG OR SCROLL TO EXPLORE · OPEN A PIECE TO VIEW IT →</p>

          <div id="art-viewport" class="art-viewport" tabindex="0" role="region" aria-label="Painting gallery, scrolls horizontally" aria-describedby="art-hint">
            <div id="art-bg" class="art-bg-grid" aria-hidden="true"></div>

            <ul id="art-track" class="art-track" role="list">
              {paintings.map((p, i) => (
                <li class="art-item">
                  <button
                    type="button"
                    class="art-btn"
                    data-index={i}
                    aria-haspopup="dialog"
                    aria-label={`Open ${p.title}, ${i + 1} of ${total}`}
                  >
                    <div class="art-frame">
                      <Picture
                        src={p.img}
                        alt={p.alt}
                        formats={['avif', 'webp']}
                        fallbackFormat="jpg"
                        widths={[320, 480, 640, 900]}
                        sizes="300px"
                        width={640}
                        quality={70}
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                        class="art-img"
                        pictureAttributes={{ class: 'art-pic' }}
                      />
                      <div class="art-grain" aria-hidden="true"></div>
                      <div class="glare" aria-hidden="true"></div>
                      <div class="art-tag" aria-hidden="true">{p.title}</div>
                      <div class="art-info" aria-hidden="true">
                        <p class="font-mono">MEDIUM: {p.medium} | {p.year}</p>
                        <p class="font-mono muted">OPEN →</p>
                      </div>
                    </div>
                  </button>
                </li>
              ))}
            </ul>
          </div>

          <!-- Directional cursor for the gallery (fine pointer only) -->
          <div class="art-cursor" id="art-cursor" aria-hidden="true">
            <span class="arr">→</span>
            <span class="lbl">SCROLL</span>
          </div>

          <div class="art-progress-rail" aria-hidden="true">
            <div id="art-progress" class="art-progress"></div>
          </div>

          <!-- Visitor gallery — deliberately linked from this page only -->
          <aside class="vg-panel" data-reveal aria-labelledby="vg-title">
            <p class="eyebrow font-mono" id="vg-title">VISITOR GALLERY /</p>
            <p class="body-copy">A drawing canvas for visitors. Leave something on the wall.</p>
            <a class="vg-link font-mono" href="/gallery-088c0fbff746/">OPEN THE CANVAS →</a>
          </aside>
        </div>
      </div>

      <!-- ── THINK ────────────────────────────────────────────────────────── -->
      <div id="tab-think" class="tab-panel" role="tabpanel" aria-labelledby="tab-think-btn" data-panel="think" tabindex="0" hidden>
        <div class="wrap panel-pad">
          <div class="grid md:grid-cols-2 gap-10 items-start">

            <div class="intro-card" data-reveal>
              <p class="eyebrow font-mono mb-4">CURIOSITY &amp; STRATEGY</p>
              <h2 class="panel-title accent">CHESS<br>&amp; BOOKS</h2>

              <div class="chess-card">
                <div class="flex items-center gap-4 mb-4">
                  <span class="font-mono text-3xl font-black accent" aria-hidden="true">♟</span>
                  <div>
                    <h3 class="font-black text-xl accent">CHESS</h3>
                    <p class="font-mono text-xs label-copy">1700 ELO — RAPID</p>
                  </div>
                </div>
                <p class="text-sm font-mono card-copy mb-3">
                  I've been playing chess seriously for a few years. At 1700 I'm comfortable with most tactical patterns — the gap now is not calculation, it's judgment about when to exchange pieces and when to keep the tension.
                </p>
                <p class="text-sm font-mono card-copy">
                  I study endgames more than openings. Openings are memorized — endgames are understood. That distinction matters.
                </p>
              </div>
            </div>

            <div class="intro-card" data-reveal>
              <p class="eyebrow font-mono mb-6">CURRENTLY READING / HAVE READ</p>

              <ol class="flex flex-col gap-4 book-list" data-reveal-stagger>
                <li class="book-card">
                  <span class="font-mono font-black book-num accent" aria-hidden="true">I.</span>
                  <div>
                    <h3 class="book-title">Crime and Punishment</h3>
                    <p class="font-mono text-xs mb-2 label-copy">Fyodor Dostoevsky</p>
                    <p class="text-xs font-mono book-note">A man who convinces himself his own logic is airtight, then watches it collapse under the weight of what he can't reason away. The most honest book about arrogance I've read.</p>
                  </div>
                </li>
                <li class="book-card">
                  <span class="font-mono font-black book-num accent" aria-hidden="true">II.</span>
                  <div>
                    <h3 class="book-title">Sapiens</h3>
                    <p class="font-mono text-xs mb-2 label-copy">Yuval Noah Harari</p>
                    <p class="text-xs font-mono book-note">Useful for putting everything in context. The agricultural revolution as the greatest con in human history is a framing I think about more than I expected when I first read it.</p>
                  </div>
                </li>
                <li class="book-card">
                  <span class="font-mono font-black book-num accent" aria-hidden="true">III.</span>
                  <div>
                    <h3 class="book-title">The Origin of Species</h3>
                    <p class="font-mono text-xs mb-2 label-copy">Charles Darwin</p>
                    <p class="text-xs font-mono book-note">Still astonishing that one person observed this much and made it cohere. The argument builds so carefully that by the time you reach the conclusion, it already feels inevitable.</p>
                  </div>
                </li>
              </ol>
            </div>

          </div>
        </div>
      </div>
      </div><!-- /tab-content -->

    </section>

    <!-- ═══ TRAVELS — Passport grid ════════════════════════════════════════════ -->
    <section id="travels" class="travels">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <p class="eyebrow font-mono">02 /</p>
          <h2 class="section-title kinetic-text">TRAVELS</h2>
          <div class="rule" aria-hidden="true"></div>
          <span class="section-count font-mono" data-counter={countryCount} data-prefix="/" data-pad="2">/{countryPadded}</span>
        </div>

        <div class="travels-counter" data-reveal>
          <span class="num font-black" data-counter={countryCount} data-pad="2">{countryPadded}</span>
          <span class="lbl font-mono">COUNTRIES VISITED</span>
        </div>

        <ul class="passport-grid" data-reveal-stagger role="list">
          {countries.map((c) => (
            <li class={`passport-card${c.home ? ' home' : ''}`}>
              <div class="pc-top">
                <span class="pc-flag" role="img" aria-label={`Flag of ${c.name}`}>{c.flag}</span>
                <span class="pc-iso font-mono">{c.iso}</span>
              </div>
              <div class="pc-name font-black">{c.name}</div>
              {(c.home || c.year || c.note) && (
                <div class="pc-meta font-mono">
                  {c.home && <span class="pc-home-tag">HOME</span>}
                  {c.year && <span>{c.year}</span>}
                  {c.note && <span class="pc-note">{c.note}</span>}
                </div>
              )}
              <span class="pc-stamp font-mono" aria-hidden="true">✓ VISITED</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

  </main>

  <!-- ═══ ART LIGHTBOX ═════════════════════════════════════════════════════════ -->
  <dialog id="art-lightbox" class="art-lb" aria-labelledby="art-lb-title">
    <div class="art-lb-content">
      <figure class="art-lb-img-wrap">
        <img id="art-lb-img" alt="" decoding="async" />
      </figure>
      <div class="art-lb-info">
        <p id="art-lb-id" class="eyebrow font-mono mb-4">ARTWORK / 01</p>
        <h2 id="art-lb-title" class="art-lb-title accent">—</h2>
        <p class="font-mono text-xs label-copy art-lb-meta"><span id="art-lb-medium"></span> <span aria-hidden="true">·</span> <span id="art-lb-year"></span></p>
        <div class="art-lb-rule" aria-hidden="true"></div>
        <p id="art-lb-desc" class="art-lb-desc"></p>
        <div class="art-lb-nav">
          <button type="button" id="art-lb-prev" class="art-lb-btn font-mono" aria-label="Previous artwork">← PREV</button>
          <span id="art-lb-counter" class="art-lb-counter font-mono" aria-live="polite">1 / {total}</span>
          <button type="button" id="art-lb-next" class="art-lb-btn font-mono" aria-label="Next artwork">NEXT →</button>
        </div>
      </div>
      <button type="button" id="art-lb-close" class="art-lb-close font-mono" aria-label="Close artwork viewer">× CLOSE</button>
    </div>
  </dialog>
  <script is:inline type="application/json" id="art-data" set:html={lightboxJson}></script>

  <Footer />
</Layout>

<style>
  .hobbies-main { padding-top: 80px; }
  .wrap { max-width: 80rem; margin-inline: auto; padding-inline: var(--gutter); }
  .panel-pad { padding-block: var(--space-12) var(--space-16); }
  .accent { color: var(--accent); }
  .muted  { color: var(--text-secondary); }

  /* ── Section headers ─────────────────────────────────────────────────────── */
  .activities { background: var(--bg-base); padding-top: var(--space-12); }
  .section-head {
    display: flex; align-items: flex-end; gap: var(--space-4);
    margin-bottom: var(--space-8);
    min-width: 0;
  }
  .eyebrow { white-space: nowrap; font-size: 12px; letter-spacing: 0.15em; color: var(--text-secondary); }
  .section-head .eyebrow { align-self: center; }
  .section-title {
    font-size: clamp(2.5rem, 9vw, 4.5rem);
    font-weight: 900;
    color: var(--text-primary);
    flex-shrink: 0;
  }
  .rule { flex: 1 1 auto; min-width: 12px; height: 1px; background: var(--border-color); }
  .section-count { font-size: 1.25rem; font-weight: 900; color: var(--text-secondary); }

  .intro-card { background: var(--bg-surface); border: 1px solid var(--border-color); padding: clamp(1.25rem, 5vw, 2rem); }
  .art-intro { margin-bottom: var(--space-12); }
  .intro-card.on-base { background: var(--bg-base); }
  .panel-title { font-size: clamp(2.25rem, 5vw, 3rem); font-weight: 900; line-height: 1; margin-bottom: var(--space-6); }
  .body-copy { color: var(--text-secondary); line-height: 1.7; font-size: 1rem; }
  .card-copy { color: var(--text-secondary); line-height: 1.6; }
  .label-copy { color: var(--text-secondary); letter-spacing: 0.1em; }

  /* ── Tab navigation ──────────────────────────────────────────────────────── */
  .tab-nav {
    position: relative;
    display: flex;
    border-bottom: 1px solid var(--border-color);
  }
  .tab-btn {
    flex: 0 1 auto;
    min-height: 48px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--text-secondary);
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 14px clamp(12px, 2.6vw, 28px);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
    margin-bottom: -1px;
    white-space: nowrap;
  }
  .tab-btn:hover { color: var(--text-primary); }
  .tab-btn[aria-selected="true"] { color: var(--text-primary); border-bottom-color: var(--accent); }
  .tab-btn:focus-visible { outline-offset: -2px; }
  @media (max-width: 480px) {
    .tab-btn { flex: 1 1 0; text-align: center; padding-inline: 4px; }
  }

  /* ── Tab panels: inactive panels are `hidden`; the entering one fades in ─── */
  .tab-panel { background: var(--bg-base); }
  .tab-panel.is-surface { background: var(--bg-surface); }
  .tab-panel:focus-visible { outline-offset: -3px; }
  .tab-panel.entering { animation: panelIn var(--dur-base) var(--ease-out); }
  @keyframes panelIn {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: none; }
  }

  /* ── Sport / book cards ──────────────────────────────────────────────────── */
  .hobby-card, .book-card, .chess-card {
    border: 1px solid var(--border-color);
    background: var(--bg-surface);
    padding: var(--space-6);
    transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }
  .chess-card { background: transparent; margin-bottom: var(--space-8); }
  .hobby-card:hover, .book-card:hover {
    border-color: var(--accent);
    box-shadow: 0 0 10px var(--accent-glow);
  }
  .chip {
    font-size: 11px; letter-spacing: 0.12em; font-weight: 700;
    padding: 3px 8px;
    color: #fff; background: var(--accent);
  }
  .book-list { list-style: none; }
  .book-card { display: flex; align-items: flex-start; gap: var(--space-4); background: var(--bg-base); padding: var(--space-4) clamp(0.875rem, 4vw, 1.5rem); }
