  /* ── Art gallery ─────────────────────────────────────────────────────────── */
  .gallery-hint { font-size: 12px; letter-spacing: 0.12em; color: var(--text-secondary); margin-bottom: var(--space-2); text-wrap: balance; }

  .art-viewport {
    position: relative;
