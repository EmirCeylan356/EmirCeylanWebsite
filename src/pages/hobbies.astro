  .pc-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
  .pc-flag { font-size: 30px; line-height: 1; }
  .pc-iso { font-size: 11px; letter-spacing: 0.12em; color: var(--text-secondary); border: 1px solid var(--border-color); padding: 2px 7px; }
  .pc-name {
    font-family: 'Space Grotesk', sans-serif;
