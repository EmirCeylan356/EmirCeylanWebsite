    letter-spacing: 0.14em;
  }
  .pc-note { opacity: 0.7; }

  /* Faint "stamp" that reveals on hover */
  .pc-stamp {
    position: absolute;
    right: 12px; bottom: 12px;
    font-size: 9px; letter-spacing: 0.14em;
    color: var(--accent);
    opacity: 0;
    transform: rotate(-8deg);
    transition: opacity .2s ease;
    pointer-events: none;
  }
  .passport-card:hover .pc-stamp { opacity: 0.7; }

  @media (prefers-reduced-motion: reduce) {
    .passport-card { transition: none; }
    .passport-card:hover { transform: none; }
  }

  /* ── Art Lightbox ────────────────────────────────────────────────────────── */
  #art-lightbox.active { display: flex !important; }
  #art-lightbox-content { animation: lbSlide 0.4s cubic-bezier(0.16,1,0.3,1); }

  @keyframes lbSlide {
    from { transform: scale(0.94) translateY(20px); opacity: 0; }
    to   { transform: scale(1) translateY(0); opacity: 1; }
  }
</style>

<script>
  // ── Tab switching (animated indicator + fade transition) ──────────────────
  (function() {
    const nav     = document.querySelector('#activities .tab-nav');
    const ind     = document.getElementById('tab-indicator');
    const content = document.getElementById('tab-content');
    if (!nav || !ind || !content) return;
    const btns    = Array.from(nav.querySelectorAll('.tab-btn'));
    const panels  = Array.from(content.querySelectorAll('.tab-panel'));

    function lockHeights() {
      let max = 0;
      panels.forEach(p => {
        const prev = { d: p.style.display, p: p.style.position, o: p.style.opacity };
        p.style.display = 'block'; p.style.position = 'static'; p.style.opacity = '0';
        max = Math.max(max, p.offsetHeight);
        p.style.display = prev.d; p.style.position = prev.p; p.style.opacity = prev.o;
      });
      content.style.minHeight = max + 'px';
    }

    function moveIndicator(btn) {
      const r = btn.getBoundingClientRect();
      const navR = nav.getBoundingClientRect();
      ind.style.width = r.width + 'px';
      ind.style.transform = `translateX(${r.left - navR.left}px)`;
    }

    function activate(name) {
      const btn = btns.find(b => b.dataset.tab === name);
      if (!btn) return;
      btns.forEach(b => b.classList.toggle('active', b === btn));
      moveIndicator(btn);

      const current = panels.find(p => p.classList.contains('active') || p.classList.contains('entering'));
      const next    = panels.find(p => p.dataset.panel === name);
      if (!next || next === current) return;

      if (current) {
        current.style.transition = 'opacity .15s ease, transform .15s ease';
        current.style.opacity = '0';
        current.style.transform = 'translateY(-8px)';
        setTimeout(() => {
          current.classList.remove('active', 'entering');
          current.style.cssText = '';
        }, 160);
      }

      setTimeout(() => {
        next.classList.add('entering');
        next.style.opacity = '0';
        next.style.transform = 'translateY(8px)';
        void next.offsetHeight; // reflow
        next.style.transition = 'opacity .2s ease, transform .2s ease';
        next.style.opacity = '1';
        next.style.transform = 'translateY(0)';
        setTimeout(() => {
          next.classList.remove('entering');
          next.classList.add('active');
          next.style.cssText = '';
          if (name === 'art') window.dispatchEvent(new Event('resize'));
        }, 220);
      }, 160);
    }

    btns.forEach(b => b.addEventListener('click', () => activate(b.dataset.tab)));

    requestAnimationFrame(() => {
      lockHeights();
      moveIndicator(btns.find(b => b.classList.contains('active')) || btns[0]);
    });
    window.addEventListener('resize', () => {
      lockHeights();
      moveIndicator(btns.find(b => b.classList.contains('active')) || btns[0]);
    });
  })();

  // ── Art Gallery horizontal drag/scroll ────────────────────────────────────
  (function() {
    if (window.matchMedia('(pointer: coarse)').matches) return;

    const viewport = document.getElementById('art-viewport');
    const track    = document.getElementById('art-track');
    const bgLayer  = document.getElementById('art-bg');
    const progress = document.getElementById('art-progress');
    if (!viewport || !track) return;

    let targetX = 0, currentX = 0, maxX = 0;
    let isOver = false, isDragging = false, dragStartX = 0, dragStartCurrent = 0;

    function calcMax() {
      const w = track.scrollWidth - viewport.offsetWidth;
      maxX = Math.max(0, w);
    }
    // Also recalc on first mouse-enter in case tab was hidden at load
    viewport.addEventListener('mouseenter', calcMax, { once: false });
    setTimeout(calcMax, 300);
    window.addEventListener('resize', calcMax);

    viewport.addEventListener('wheel', (e) => {
      if (!isOver) return;
      e.preventDefault();
      targetX -= e.deltaY * 1.3;
      targetX  = Math.max(-maxX, Math.min(0, targetX));
    }, { passive: false });

    viewport.addEventListener('mouseenter', () => { isOver = true; });
    viewport.addEventListener('mouseleave', () => { isOver = false; });

    viewport.addEventListener('mousedown', (e) => {
      isDragging = true; dragStartX = e.clientX; dragStartCurrent = targetX;
      viewport.classList.add('grabbing');
    });
    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      targetX = Math.max(-maxX, Math.min(0, dragStartCurrent + (e.clientX - dragStartX)));
    });
    window.addEventListener('mouseup', () => { isDragging = false; viewport.classList.remove('grabbing'); });

    function raf() {
      requestAnimationFrame(raf);
      currentX += (targetX - currentX) * 0.08;
      const x = Math.round(currentX * 100) / 100;
      track.style.transform = `translateX(${x}px)`;
      if (bgLayer) bgLayer.style.transform = `translateX(${x * 0.2}px)`;
      if (progress) progress.style.width = (maxX > 0 ? (Math.abs(x) / maxX) * 100 : 0) + '%';
    }
    raf();
  })();

  // ── Art Gallery — directional cursor + 3D tilt + glare (Snippet 04) ───────
  (function() {
    const vport  = document.getElementById('art-viewport');
    const cursor = document.getElementById('art-cursor');
    const cards  = document.querySelectorAll('.art-item');
    if (!vport || !cursor) return;
    const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const COARSE  = window.matchMedia('(pointer: coarse)').matches;
    if (COARSE) return;

    // Directional cursor
    vport.addEventListener('pointerenter', () => { if (!REDUCED) cursor.classList.add('active'); });
    vport.addEventListener('pointerleave', () => cursor.classList.remove('active'));
    vport.addEventListener('pointermove', (e) => {
      cursor.style.left = e.clientX + 'px';
      cursor.style.top  = e.clientY + 'px';
      const r = vport.getBoundingClientRect();
      const xrel = (e.clientX - r.left) / r.width;
      cursor.classList.toggle('flip', xrel < 0.5);
      const lbl = cursor.querySelector('.lbl');
      if (lbl) lbl.textContent = xrel < 0.5 ? '← PREV' : 'NEXT →';
    });

    // 3D tilt + glare
    cards.forEach((card) => {
      const frame = card.querySelector('.art-frame');
      const glare = card.querySelector('.glare');
      if (!frame) return;
      card.addEventListener('pointermove', (e) => {
        if (REDUCED) return;
        const r = frame.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width;
        const py = (e.clientY - r.top)  / r.height;
        const ry = (px - 0.5) *  16;
        const rx = (py - 0.5) * -16;
        frame.style.transform = `rotateX(${rx}deg) rotateY(${ry}deg) translateZ(0)`;
        if (glare) {
          glare.style.setProperty('--gx', (px * 100) + '%');
          glare.style.setProperty('--gy', (py * 100) + '%');
        }
      });
      card.addEventListener('pointerleave', () => { frame.style.transform = ''; });
    });
  })();

  // ── Art Lightbox ───────────────────────────────────────────────────────────
