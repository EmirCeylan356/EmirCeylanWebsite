  }
  .travels-counter .lbl {
    font-size: 12px;
    letter-spacing: 0.16em;
    color: var(--text-secondary);
    text-transform: uppercase;
  }

  .passport-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
