  .art-lb-info {
    flex: 1 1 auto; min-height: 0; overflow-y: auto;
    padding: var(--space-6) var(--space-6) var(--space-6);
    border-top: 1px solid var(--border-color);
    display: flex; flex-direction: column;
  }
  .art-lb-title { font-size: clamp(1.5rem, 3.5vw, 2rem); font-weight: 900; line-height: 1; margin-bottom: 8px; padding-right: 96px; }
  .art-lb-meta { margin-bottom: var(--space-4); }
  .art-lb-rule { height: 1px; background: var(--border-color); margin-bottom: var(--space-4); }
  .art-lb-desc { color: var(--text-secondary); font-size: 0.9rem; line-height: 1.7; flex: 1 1 auto; }
  .art-lb-nav {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-3);
    margin-top: var(--space-6); padding-top: var(--space-4);
    border-top: 1px solid var(--border-color);
  }
  .art-lb-btn, .art-lb-close {
    min-height: 44px;
    padding: 10px 14px;
    background: none; border: 1px solid var(--border-color);
    color: var(--text-primary);
    font-size: 12px; font-weight: 700; letter-spacing: 0.12em;
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
