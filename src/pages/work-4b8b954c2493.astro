---
// ════════════════════════════════════════════════════════════════════════════
//  PRIVATE RECRUITER WORK PAGE  —  /work-4b8b954c2493/
//
//  The single link Emir sends to a recruiter. LINK-BASED PRIVACY, NOT
//  AUTHENTICATION: anyone with the URL can view it. noindex via Layout,
//  excluded from the sitemap, Disallow-ed in robots.txt, never linked from a
//  public page. Only links out: to /cv-4b8b954c2493/ and to /.
//
//  Everything below renders from src/data/profile.ts (PRIVATE_*) so this page
//  and the CV page cannot drift. No phone number anywhere.
// ════════════════════════════════════════════════════════════════════════════
import '../styles/print.css';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site';
import {
  CV_TITLE,
  CV_PDF_PATH,
  PRIVATE_INTRO,
  PRIVATE_EDUCATION,
  PRIVATE_EXPERIENCE,
  PRIVATE_PROJECTS,
  PRIVATE_LEADERSHIP,
  PRIVATE_CERTIFICATIONS,
  PUBLIC_SKILLS,
  contactMailto,
} from '../data/profile';

const short = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '');

const contacts = [
  { label: 'Email', value: SITE.email, href: contactMailto('Work opportunity') },
  { label: 'GitHub', value: short(SITE.github), href: SITE.github, external: true },
  { label: 'LinkedIn', value: short(SITE.linkedin), href: SITE.linkedin, external: true },
];

const KIND_LABEL: Record<string, string> = {
  internship: 'Internship',
  research: 'Research',
  teaching: 'Teaching',
  leadership: 'Leadership',
};

const skillGroups = PUBLIC_SKILLS.primary.concat(PUBLIC_SKILLS.secondary.filter((g) => g.title === 'Spoken'));

const sections = [
  { n: '01', id: 'experience', label: 'Experience' },
  { n: '02', id: 'projects', label: 'Selected projects' },
  { n: '03', id: 'education', label: 'Education' },
  { n: '04', id: 'credentials', label: 'Credentials & leadership' },
  { n: '05', id: 'skills', label: 'Skills' },
];
---

<Layout title="Work — Emir Ceylan (Private)" noindex={true} description="Full work history of Emir Ceylan. Unlisted; shared by link." bodyClass="work-page">
  <Header />

  <main class="work-main">
    <div class="container">

      <!-- ═══ NOTICE + INTRO ═══════════════════════════════════════════════ -->
      <section class="intro doc" aria-labelledby="work-heading">
        <p class="private-note font-mono no-print">
          <span class="dot" aria-hidden="true"></span>
          <span>PRIVATE / UNLISTED — shared by link only. Full work history for recruiters.</span>
        </p>

        <header class="doc-header">
          <h1 id="work-heading" class="doc-name kinetic-text">Emir Ceylan</h1>
          <p class="doc-title">{CV_TITLE}</p>
        </header>

        <div class="intro-grid">
          <div class="intro-copy">
            <p class="lede">{PRIVATE_INTRO.who}</p>
            <p class="looking">{PRIVATE_INTRO.lookingFor}</p>
          </div>

          <div class="contact-block">
            <ul class="contact-list doc-contact" aria-label="Contact">
              {contacts.map((c) => (
                <li>
                  <span class="c-label font-mono" aria-hidden="true">{c.label}</span>
                  <a href={c.href} class="c-link font-mono" target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener noreferrer' : undefined}>
                    {c.value}{c.external && <span class="sr-only"> (opens in a new tab)</span>}
                  </a>
                </li>
              ))}
            </ul>
            <div class="cv-actions no-print">
              <a href={CV_PDF_PATH} class="btn btn-primary font-mono" download="Emir_Ceylan_CV.pdf">Download CV (PDF)</a>
              <a href="/cv-4b8b954c2493/" class="btn btn-secondary font-mono">CV as a web page →</a>
            </div>
          </div>
        </div>

        <nav class="jump no-print" aria-label="Sections on this page">
          <ol>
            {sections.map((s) => (
              <li><a href={`#${s.id}`} class="font-mono"><span class="n">{s.n}</span> {s.label}</a></li>
            ))}
          </ol>
        </nav>
      </section>

      <!-- ═══ 01 EXPERIENCE ═══════════════════════════════════════════════ -->
      <section id="experience" class="section doc-section" aria-labelledby="h-experience">
        <div class="section-head">
          <p class="eyebrow">01 /</p>
          <h2 id="h-experience" class="section-title kinetic-text doc-section-title">Experience</h2>
          <div class="section-line" data-reveal="line"></div>
        </div>

        <ol class="timeline" data-reveal-stagger>
          {PRIVATE_EXPERIENCE.map((e) => (
            <li class="timeline-item doc-item">
              <div class="t-meta">
                <span class="doc-item-period font-mono">{e.period}</span>
                <span class="kind font-mono">{KIND_LABEL[e.kind]}{e.current ? ' · ongoing' : ''}</span>
              </div>
              <div class="t-body">
                <div class="doc-item-head">
                  <h3 class="doc-item-title">{e.title}</h3>
                </div>
                <p class="doc-item-org">{e.org}{e.location ? ` · ${e.location}` : ''}</p>
                <ul class="doc-bullets">
                  {e.bullets.map((b) => <li>{b}</li>)}
                </ul>
                {e.stack && (
                  <p class="doc-stack chips"><span class="sr-only">Stack: </span>{e.stack.map((s) => <span class="chip">{s}</span>)}</p>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- ═══ 02 PROJECTS ═════════════════════════════════════════════════ -->
      <section id="projects" class="section doc-section" aria-labelledby="h-projects">
        <div class="section-head">
          <p class="eyebrow">02 /</p>
          <h2 id="h-projects" class="section-title kinetic-text doc-section-title">Selected projects</h2>
          <div class="section-line" data-reveal="line"></div>
        </div>

        <div class="cards" data-reveal-stagger>
          {PRIVATE_PROJECTS.map((p) => (
            <article class="card doc-item" aria-labelledby={`p-${p.title.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`}>
              <div class="doc-item-head">
                <h3 id={`p-${p.title.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`} class="doc-item-title">{p.title}</h3>
                <span class="doc-item-period font-mono">{p.period}</span>
              </div>
              <p class="doc-item-org">{p.role}{p.context ? ` · ${p.context}` : ''}{p.status ? ` · ${p.status}` : ''}</p>
              {p.award && <p class="award doc-award font-mono">★ {p.award}</p>}
              <ul class="doc-bullets">
                {p.bullets.map((b) => <li>{b}</li>)}
              </ul>
              <p class="doc-stack chips"><span class="sr-only">Stack: </span>{p.stack.filter((s) => !s.startsWith('TODO')).map((s) => <span class="chip">{s}</span>)}</p>
              {p.link && (
                <p class="repo">
                  <a href={p.link} class="font-mono" target="_blank" rel="noopener noreferrer">{short(p.link)} <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
                </p>
              )}
            </article>
          ))}
        </div>
      </section>

      <!-- ═══ 03 EDUCATION ════════════════════════════════════════════════ -->
      <section id="education" class="section doc-section" aria-labelledby="h-education">
        <div class="section-head">
          <p class="eyebrow">03 /</p>
          <h2 id="h-education" class="section-title kinetic-text doc-section-title">Education</h2>
          <div class="section-line" data-reveal="line"></div>
        </div>
        <div class="edu doc-item">
          <div class="doc-item-head">
            <h3 class="doc-item-title">{PRIVATE_EDUCATION.school}</h3>
            <span class="doc-item-period font-mono">{PRIVATE_EDUCATION.period}</span>
          </div>
          <p class="doc-item-org">{PRIVATE_EDUCATION.degree} · {PRIVATE_EDUCATION.location}</p>
          <ul class="doc-bullets">
            {PRIVATE_EDUCATION.notes.map((n) => <li>{n}</li>)}
          </ul>
        </div>
      </section>

      <!-- ═══ 04 CREDENTIALS & LEADERSHIP ═════════════════════════════════ -->
      <section id="credentials" class="section doc-section" aria-labelledby="h-credentials">
        <div class="section-head">
          <p class="eyebrow">04 /</p>
          <h2 id="h-credentials" class="section-title kinetic-text doc-section-title">Credentials &amp; leadership</h2>
          <div class="section-line" data-reveal="line"></div>
        </div>
        <div class="doc-two-col two-col">
          <div class="doc-item">
            <h3 class="sub font-mono">Certifications</h3>
            <ul class="doc-bullets doc-plain-list">
              {PRIVATE_CERTIFICATIONS.map((c) => <li>{c}</li>)}
            </ul>
          </div>
          <div class="doc-item">
            <h3 class="sub font-mono">Leadership</h3>
            <ul class="doc-bullets doc-plain-list">
              {PRIVATE_LEADERSHIP.map((l) => <li>{l}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <!-- ═══ 05 SKILLS ═══════════════════════════════════════════════════ -->
      <section id="skills" class="section doc-section" aria-labelledby="h-skills">
        <div class="section-head">
          <p class="eyebrow">05 /</p>
          <h2 id="h-skills" class="section-title kinetic-text doc-section-title">Skills</h2>
          <div class="section-line" data-reveal="line"></div>
        </div>
        <dl class="skills">
          {skillGroups.map((g) => (
            <div class="doc-skill-row skill-row">
              <dt class="font-mono">{g.title}</dt>
              <dd>
                <span class="chips">{g.items.map((s) => <span class="chip">{s}</span>)}</span>
                {g.note && <span class="note">{g.note}</span>}
              </dd>
            </div>
          ))}
        </dl>
      </section>

      <div class="page-links no-print">
        <a href="/" class="btn btn-secondary font-mono">← Back to site</a>
        <a href={contactMailto('Work opportunity')} class="btn btn-primary font-mono">Get in touch →</a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* ── Layout primitives (same conventions as index.astro, page-local) ─── */
  /* Small crimson text needs a lighter tint to clear 4.5:1 on the dark surfaces. */
  .container { --accent-text: #EE5A72; }
  .container { max-width: 68rem; margin-inline: auto; padding-inline: var(--gutter); }
  .work-main { padding-top: calc(60px + var(--space-12)); padding-bottom: var(--section-y); }
  .section { padding-block: clamp(var(--space-12), 6vw, var(--space-20)); border-top: 1px solid var(--border-color); }
  .section-head { display: flex; align-items: flex-end; gap: var(--space-4); margin-bottom: clamp(var(--space-8), 4vw, var(--space-12)); }
  .section-head .eyebrow { align-self: center; margin: 0; }
  .section-title { font-size: clamp(2rem, 5vw, 3.25rem); font-weight: 900; color: var(--text-primary); }
  .section-line { flex: 1; height: 1px; background: var(--border-color); align-self: center; }
  .eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--text-secondary); }

  /* ── Notice ──────────────────────────────────────────────────────────── */
  .private-note {
    display: inline-flex; align-items: center; gap: 12px;
    padding: 10px 16px; min-height: 44px;
    border: 1px solid var(--border-color);
    background: rgba(196,30,58,0.06);
    font-size: 11px; letter-spacing: 0.08em; color: var(--text-secondary);
    margin-bottom: var(--space-8);
  }
  .private-note .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 8px rgba(196,30,58,0.8); flex-shrink: 0; }

  /* ── Intro ───────────────────────────────────────────────────────────── */
  .intro { padding-bottom: clamp(var(--space-8), 4vw, var(--space-12)); }
  .doc-header { margin-bottom: var(--space-8); }
  .doc-name { font-size: clamp(2.75rem, 8vw, 5rem); font-weight: 900; color: var(--text-primary); }
  .doc-title { color: var(--text-secondary); margin-top: var(--space-3); font-size: clamp(1rem, 1.5vw, 1.2rem); }
  .intro-grid { display: grid; gap: var(--space-8); }
  @media (min-width: 900px) { .intro-grid { grid-template-columns: 1.4fr 1fr; gap: var(--space-12); } }
  .lede { font-size: clamp(1.1rem, 1rem + 0.5vw, 1.35rem); font-weight: 700; line-height: 1.5; color: var(--text-primary); text-wrap: balance; margin-bottom: var(--space-4); }
  .looking { color: var(--text-secondary); max-width: 58ch; }
  .looking::before { content: '▸ '; color: var(--accent); }

  .contact-list { list-style: none; display: grid; gap: 2px; }
  .contact-list li { display: grid; grid-template-columns: 5.5rem 1fr; align-items: center; }
  .c-label { font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-tertiary); }
  .c-link { overflow-wrap: anywhere; display: inline-flex; align-items: center; min-height: 44px; font-size: 0.85rem; color: var(--text-primary); text-decoration: none; border-bottom: 1px solid transparent; transition: color var(--dur-fast) var(--ease-out); }
  .c-link:hover { color: var(--accent-text); }
  .cv-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-4); }

  .btn {
    font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none;
    padding: 12px 22px; min-height: 44px; display: inline-flex; align-items: center; gap: 8px;
    border: 1px solid transparent; cursor: pointer;
    transition: background var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);
  }
  .btn-primary { color: var(--accent-text); border-color: var(--accent); }
  .btn-primary:hover { background: var(--accent); color: #fff; box-shadow: 0 0 24px var(--accent-glow); }
  .btn-secondary { color: var(--text-primary); border-color: var(--border-color); }
  .btn-secondary:hover { border-color: var(--text-primary); }

  .jump { margin-top: var(--space-8); border-top: 1px dashed var(--border-color); padding-top: var(--space-4); }
  .jump ol { list-style: none; display: flex; flex-wrap: wrap; gap: 0 var(--space-6); }
  .jump a { display: inline-flex; align-items: center; min-height: 44px; font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-secondary); text-decoration: none; }
  .jump a:hover { color: var(--text-primary); }
  .jump .n { color: var(--accent-text); margin-right: 0.5em; }

  /* ── Shared item typography ──────────────────────────────────────────── */
  .doc-item-head { display: flex; justify-content: space-between; gap: var(--space-4); align-items: baseline; flex-wrap: wrap; }
  .doc-item-title { font-size: clamp(1.1rem, 1.6vw, 1.3rem); font-weight: 700; color: var(--text-primary); line-height: 1.3; }
  .doc-item-org { color: var(--text-secondary); margin-top: 0.15rem; }
  .doc-item-period { font-size: 0.75rem; letter-spacing: 0.1em; color: var(--text-tertiary); white-space: nowrap; }
  .doc-bullets { list-style: none; margin-top: var(--space-3); }
  .doc-bullets li { position: relative; padding-left: 1.2rem; color: var(--text-secondary); line-height: 1.65; margin-bottom: 0.4rem; max-width: 72ch; }
  .doc-bullets li::before { content: '▸'; position: absolute; left: 0; color: var(--accent); font-weight: 700; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: var(--space-3); }
  .chip {
    font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; letter-spacing: 0.04em;
    color: var(--text-secondary); border: 1px solid var(--border-color); background: var(--bg-base); padding: 3px 8px; line-height: 1.4;
  }

  /* ── Timeline ────────────────────────────────────────────────────────── */
  .timeline { list-style: none; position: relative; }
  .timeline::before { content: ''; position: absolute; left: 0; top: 6px; bottom: 6px; width: 1px; background: var(--border-color); }
  .timeline-item { position: relative; padding-left: var(--space-8); padding-bottom: var(--space-10, 2.5rem); display: grid; gap: var(--space-2); }
  .timeline-item:last-child { padding-bottom: 0; }
  .timeline-item::before { content: ''; position: absolute; left: -4px; top: 8px; width: 9px; height: 9px; background: var(--accent); box-shadow: 0 0 10px var(--accent-glow); }
  @media (min-width: 800px) {
    .timeline-item { grid-template-columns: 11rem 1fr; gap: var(--space-6); padding-left: var(--space-10, 2.5rem); }
  }
  .t-meta { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); align-items: baseline; }
  @media (min-width: 800px) { .t-meta { flex-direction: column; gap: var(--space-1); } }
  .kind { font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-text); }

  /* ── Project cards ───────────────────────────────────────────────────── */
  .cards { display: grid; gap: var(--space-4); }
  @media (min-width: 900px) { .cards { grid-template-columns: 1fr 1fr; } }
  .card { background: var(--bg-surface); border: 1px solid var(--border-color); padding: clamp(var(--space-4), 3vw, var(--space-6)); position: relative; }
  .card::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 2px; background: var(--accent); transform: scaleY(0); transform-origin: top; transition: transform var(--dur-base) var(--ease-out); }
  .card:hover::before { transform: scaleY(1); }
  .award { display: inline-block; margin-top: var(--space-2); font-size: 0.72rem; letter-spacing: 0.08em; color: var(--accent-text); border: 1px solid var(--accent); padding: 4px 10px; }
  .repo { margin-top: var(--space-3); }
  .repo a { overflow-wrap: anywhere; display: inline-flex; align-items: center; min-height: 44px; font-size: 0.78rem; color: var(--text-primary); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--border-color); }
  .repo a:hover { text-decoration-color: var(--accent); }

  /* ── Education / credentials / skills ────────────────────────────────── */
  .two-col { display: grid; gap: var(--space-8); }
  @media (min-width: 700px) { .two-col { grid-template-columns: 1fr 1fr; } }
  .sub { font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--text-tertiary); font-weight: 700; }

  .skills { display: grid; gap: var(--space-5, 1.25rem); }
  .skill-row { display: grid; gap: var(--space-2); }
  @media (min-width: 700px) { .skill-row { grid-template-columns: 9rem 1fr; gap: var(--space-4); } }
  .skill-row dt { font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-tertiary); padding-top: 5px; }
  .skill-row dd .chips { margin-top: 0; }
  .note { display: block; margin-top: var(--space-2); color: var(--text-secondary); font-size: 0.9rem; max-width: 60ch; }

  .page-links { display: flex; flex-wrap: wrap; gap: var(--space-3); border-top: 1px solid var(--border-color); padding-top: var(--space-8); }
</style>
