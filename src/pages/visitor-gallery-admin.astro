---
// Gallery admin — unlisted. The gate is Supabase Auth (email + password
// created under Authentication → Users in the Supabase dashboard). Nothing
// secret lives in this file: the anon key is public by design and the only
// real protection is the Row Level Security policies in docs/SUPABASE.md.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="GALLERY ADMIN" description="Moderation console for the visitor gallery." noindex={true}>
  <Header />

  <main class="adm" style="padding-top: 80px;">
    <section class="adm-section">
      <div class="max-w-7xl mx-auto">

        <!-- Sign-in (shown until a Supabase session exists) -->
        <div id="login-view" class="adm-login">
          <p class="font-mono text-xs mb-3 adm-eyebrow">ADMIN /</p>
          <h1 class="font-black kinetic-text mb-8 adm-h1">SIGN IN</h1>

          <div id="admin-setup" hidden class="adm-notice" role="status">
            <span style="color:var(--accent);">SUPABASE NOT CONFIGURED</span><br/>
            Add <code>PUBLIC_SUPABASE_URL</code> and <code>PUBLIC_SUPABASE_ANON_KEY</code> to <code>.env</code>.
          </div>

          <form id="login-form" class="adm-form" novalidate>
            <div>
              <label for="email-input" class="font-mono text-xs adm-label">EMAIL</label>
              <input type="email" id="email-input" name="email" required autocomplete="username" placeholder="you@example.com" class="admin-input font-mono text-sm" />
            </div>
            <div>
              <label for="pw-input" class="font-mono text-xs adm-label">PASSWORD</label>
              <input type="password" id="pw-input" name="password" required autocomplete="current-password" placeholder="••••••••" class="admin-input font-mono text-sm" />
            </div>
            <p id="login-error" class="font-mono text-xs adm-error" role="alert" aria-live="polite" hidden></p>
            <button type="submit" id="login-btn" class="font-mono text-sm font-bold cut-corner admin-login-btn">SIGN IN</button>
            <p class="font-mono text-xs adm-dim">Uses a Supabase Auth account. Sessions persist in this browser until you sign out.</p>
          </form>
        </div>

        <!-- Dashboard (only while a session exists) -->
        <div id="dashboard-view" hidden>
          <div class="adm-topbar">
            <div>
              <p class="font-mono text-xs mb-2 adm-eyebrow">ADMIN /</p>
              <h1 class="font-black kinetic-text adm-h1 adm-h1-dash">
                GALLERY<span style="color:var(--accent);">_</span>ADMIN
              </h1>
            </div>
            <div class="adm-actions">
              <button type="button" id="refresh-btn" class="font-mono text-xs font-bold cut-corner-sm admin-action-btn">REFRESH</button>
              <button type="button" id="signout-btn" class="font-mono text-xs font-bold cut-corner-sm admin-ghost-btn">SIGN OUT</button>
              <!-- No link to the unlisted gallery here: this markup is public. -->
            </div>
          </div>

          <!-- Status bar -->
          <div class="panel adm-status" role="status">
            <span class="adm-dot" aria-hidden="true"></span>
            <span class="font-mono text-xs font-bold" style="color:var(--accent); letter-spacing:0.1em;">AUTHENTICATED</span>
            <span class="font-mono text-xs adm-dim" id="admin-who"></span>
            <span class="font-mono text-xs adm-dim" aria-hidden="true">|</span>
            <span id="admin-count" class="font-mono text-xs" style="color:var(--text-secondary);">Loading...</span>
          </div>

          <p id="admin-error" class="font-mono text-xs adm-error adm-error-box" role="alert" hidden></p>

          <div id="admin-grid" class="admin-grid"></div>
          <div id="admin-empty" hidden class="adm-empty">
            <p class="font-mono text-sm" style="color:var(--text-secondary);">No submissions found.</p>
          </div>
        </div>

      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  import '../scripts/gallery-admin';
</script>

<!-- Global on purpose: cards are built in JS and would not carry Astro's scope attribute. -->
<style is:global>
  .adm [hidden] { display: none !important; }
  .adm-section { padding: var(--space-12) var(--gutter); min-height: 70vh; }
  .adm-eyebrow { color: var(--text-secondary); letter-spacing: 0.15em; }
  .adm-dim { color: var(--text-tertiary); }
  .adm-h1 { font-family: 'Space Grotesk', sans-serif; font-size: 3rem; color: var(--text-primary); }
  .adm-h1-dash { font-size: clamp(2rem, 5vw, 3.5rem); }
  .adm-login { max-width: 420px; margin: 3rem auto; }
  .adm-form { display: flex; flex-direction: column; gap: 1rem; }
  .adm-label { display: block; margin-bottom: 0.45rem; color: var(--text-secondary); letter-spacing: 0.12em; }
  .adm-notice { padding: 0.75rem 1rem; margin-bottom: 1.5rem; background: var(--bg-elevated); border: 1px solid var(--border-color); font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; color: var(--text-secondary); line-height: 1.8; }
  .adm-notice code { color: var(--text-primary); }
  .adm-error { color: #FF0055; }
  .adm-error-box { border: 1px solid #FF0055; padding: 0.75rem 1rem; margin-bottom: 1.5rem; background: rgba(255,0,85,0.07); }

  .admin-input { width: 100%; background: var(--bg-elevated); border: 1px solid var(--border-color); color: var(--text-primary); padding: 0.85rem 1rem; outline: none; transition: border-color var(--dur-base), box-shadow var(--dur-base); }
  .admin-input:focus { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
  .admin-input::placeholder { color: var(--text-tertiary); }

  .admin-login-btn { background: var(--accent); color: #fff; border: 1px solid var(--accent); letter-spacing: 0.1em; cursor: pointer; padding: 1rem; transition: background var(--dur-base), color var(--dur-base), box-shadow var(--dur-base); }
  .admin-login-btn:hover:not(:disabled) { background: transparent; color: var(--accent); box-shadow: 0 0 16px var(--accent-glow); }
  .admin-login-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .adm-topbar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem; }
  .adm-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .admin-action-btn, .admin-ghost-btn { letter-spacing: 0.08em; padding: 0.55rem 1rem; cursor: pointer; transition: background var(--dur-base), color var(--dur-base), border-color var(--dur-base); }
  .admin-action-btn { background: var(--accent); color: #fff; border: 1px solid var(--accent); }
  .admin-action-btn:hover { background: transparent; color: var(--accent); }
  .admin-ghost-btn { background: transparent; color: var(--text-primary); border: 1px solid var(--border-color); }
  .admin-ghost-btn:hover { border-color: var(--accent); color: var(--accent); }

  .adm-status { padding: 1rem 1.5rem; margin-bottom: 2rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .adm-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); display: inline-block; box-shadow: 0 0 6px var(--accent); }
  .adm-empty { text-align: center; padding: 4rem 0; }

  .admin-grid { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .admin-card { background: var(--bg-surface); border: 1px solid var(--border-color); padding: 1rem; transition: border-color var(--dur-base); }
  .admin-card:hover { border-color: var(--accent); }
  .admin-card img { width: 100%; height: auto; aspect-ratio: 600 / 390; object-fit: cover; display: block; border: 1px solid var(--border-color); margin-bottom: 0.75rem; background: #fff; }
  .admin-badimg { aspect-ratio: 600 / 390; display: flex; align-items: center; justify-content: center; text-align: center; font-size: 10px; color: #FF0055; border: 1px dashed #FF0055; margin-bottom: 0.75rem; padding: 1rem; }
  .admin-title { font-family: 'Space Grotesk', sans-serif; font-weight: 800; font-size: 0.95rem; color: var(--text-primary); overflow-wrap: anywhere; }
  .admin-sub { color: var(--text-secondary); margin-top: 0.25rem; overflow-wrap: anywhere; }
  .admin-meta { color: var(--text-tertiary); margin-top: 0.25rem; }

  .del-btn { background: transparent; color: #FF0055; border: 1px solid #FF0055; font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; font-weight: 700; padding: 0.4rem 0.75rem; cursor: pointer; letter-spacing: 0.08em; transition: background var(--dur-fast), color var(--dur-fast); margin-top: 0.6rem; }
  .del-btn:hover:not(:disabled) { background: #FF0055; color: #0a0a0a; }
  .del-btn:disabled { opacity: 0.4; cursor: not-allowed; }
</style>
