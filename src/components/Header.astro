---
import { SITE } from '../lib/site';

// The visitor gallery is unlisted (see src/pages/gallery-088c0fbff746.astro) —
// deliberately not in the nav. Don't add a link to it from any public page.
// The recruiter hub (/work-…) and CV page are likewise never linked here.
const navItems = [
  { name: 'Main', href: '/' },
  { name: 'Blog', href: '/blog/' },
  { name: 'Now', href: '/now/' },
  { name: 'Hobbies', href: '/hobbies/' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header fixed top-0 left-0 right-0 z-50">
  <nav class="site-nav" aria-label="Primary">
    <a href="/" class="logo-mark" aria-label="Emir Ceylan — home">
      EC<span class="logo-cursor" aria-hidden="true">_</span>
    </a>

    <p class="brand-line font-mono" aria-hidden="true">{SITE.tagline} — ISTANBUL</p>

    <ul class="nav-list">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="nav-link font-mono"
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.name}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    background: color-mix(in srgb, var(--bg-surface) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-color);
  }
  .site-nav {
    max-width: 80rem; margin-inline: auto;
    padding: 0 max(0.75rem, env(safe-area-inset-left)) 0 max(1rem, env(safe-area-inset-right));
    min-height: 60px;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  }
  .logo-mark {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.5rem; font-weight: 900; letter-spacing: -0.04em;
    color: var(--accent);
    text-decoration: none;
    display: inline-flex; align-items: center; min-height: 44px;
    text-shadow: 0 0 8px rgba(196,30,58,0.45);
    transition: text-shadow var(--dur-base) var(--ease-out);
  }
  .logo-mark:hover { text-shadow: 0 0 16px rgba(196,30,58,0.75); }
  .logo-cursor { color: var(--border-color); animation: tw-blink 1.1s steps(2) infinite; }

  .brand-line {
    display: none;
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em;
    color: var(--text-secondary);
    margin: 0;
    flex: 1; text-align: center;
  }
  @media (min-width: 900px) { .brand-line { display: block; } }

  .nav-list { display: flex; align-items: center; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .nav-link {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 44px; min-width: 44px;
    padding: 0 0.85rem;
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--text-secondary);
    text-decoration: none;
    border: 1px solid transparent;
    clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);
    transition: color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .nav-link:hover, .nav-link:focus-visible { color: #fff; background: var(--accent); border-color: var(--accent); outline-offset: -3px; }
  .nav-link[aria-current="page"] { color: var(--text-primary); position: relative; }
  .nav-link[aria-current="page"]::after {
    content: ''; position: absolute; left: 0.85rem; right: 0.85rem; bottom: 8px; height: 2px;
    background: var(--accent);
  }
  .nav-link[aria-current="page"]:hover::after { background: #fff; }
  @media (max-width: 420px) {
    .nav-link { padding: 0 0.6rem; font-size: 0.66rem; letter-spacing: 0.08em; }
    .nav-link[aria-current="page"]::after { left: 0.6rem; right: 0.6rem; }
  }
</style>
