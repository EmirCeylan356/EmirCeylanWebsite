---
// One row in the blog index / tag listing.
import type { Post } from './posts';
import { formatDate, isoDate, readingTime } from './posts';
import TagChips from './TagChips.astro';
interface Props { post: Post; index?: number }
const { post, index = 0 } = Astro.props;
const rt = readingTime(post.body);
---
<li class="post-card panel" style={`--i:${index}`}>
  <p class="post-meta">
    <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
    <span aria-hidden="true">·</span>
    <span>{rt.minutes} min read</span>
    {post.data.draft && <span class="draft-badge">DRAFT</span>}
  </p>
  <h2 class="post-title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
  <p class="post-desc">{post.data.description}</p>
  <TagChips tags={post.data.tags} />
</li>

<style>
  .post-card { padding: clamp(var(--space-6), 3vw, var(--space-8)); transition: border-color var(--dur-base) var(--ease-out); }
  .post-card:hover { border-color: var(--accent); }
  .post-meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2);
    font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--text-tertiary); margin-bottom: var(--space-3);
  }
  .draft-badge { color: #fff; background: var(--accent); padding: 0.1rem 0.45rem; font-weight: 700; }
  .post-title { font-size: clamp(1.35rem, 1.1rem + 1vw, 1.9rem); line-height: 1.2; letter-spacing: -0.01em; margin-bottom: var(--space-3); }
  .post-title a { color: var(--text-primary); text-decoration: none; }
  .post-title a::after { content: ''; position: absolute; inset: 0; }
  .post-title a:hover { color: var(--accent); }
  .post-desc { color: var(--text-secondary); max-width: 62ch; margin-bottom: var(--space-4); }
  /* Keep tag links clickable above the stretched title link. */
  .post-card :global(.tag-chips) { position: relative; z-index: 1; }
</style>
