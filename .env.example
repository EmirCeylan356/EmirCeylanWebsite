# Copy to .env — never commit .env.
# Supabase project for the visitor gallery (anon key is public by design; RLS
# policies in docs/SUPABASE.md are what actually protect the table).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Analytics: set to "vercel" to inject the Vercel Web Analytics script
# (cookieless). Requires enabling Analytics on the Vercel project once.
PUBLIC_ANALYTICS=
